{%- liquid
  assign desktop_height = desktop_height | default: section.settings.height
  assign mobile_height = mobile_height | default: section.settings.height_mobile

  assign default_image = 'blank.svg' | asset_url
  assign image = section.settings.image | default: default_image
  assign image_mobile = section.settings.mobile_image

  assign transparency_class = ''
  if section.settings.transparent
    assign transparency_class = 'hero__content__wrapper--transparent'
  endif

  assign animation_anchor = '#video--' | append: section.id
  assign transition_text = settings.transition_text
  assign overlay_color = section.settings.overlay_color
  assign overlay_opacity = section.settings.overlay_opacity | times: 0.01 | round: 2
  assign animation_delay = 0

  assign link_text = section.settings.link_text
  assign video_popup = section.settings.video_popup | default: section.settings.video_popup_social
  assign video_bg = section.settings.video_bg

  assign btn_size = section.settings.btn_size
  assign btn_style = section.settings.btn_style
  assign btn_type = section.settings.btn_type

  assign show_video_popup = false
  if section.settings.show_video_popup and video_popup != blank
    assign show_video_popup = true
  endif
-%}

{%- unless overlay_color == 'rgba(0,0,0,0)' or overlay_color == '' or overlay_opacity == 0 -%}
  {%- style -%}
    [data-section-id="{{ section.id }}"] {
      --overlay-color: {{ overlay_color }};
      --overlay-opacity: {{ overlay_opacity }};
    }
  {%- endstyle -%}
{%- endunless -%}

<div class="hero__content__wrapper {{ section.settings.flex_align }} {{ transparency_class }}" id="video--{{ section.id }}">
  <div class="hero__content" data-banner-content>
    {%- if section.settings.title != blank -%}
      <h1 class="hero__title"
        {% if transition_text %}
        data-aos="fade-up"
        data-aos-delay="{{ animation_delay }}"
        data-aos-anchor="{{ animation_anchor }}"
        {% endif %}>
        {{ section.settings.title | escape }}
      </h1>
      {%- assign animation_delay = animation_delay | plus: 250 -%}
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="hero__description"
        {% if transition_text %}
        data-aos="fade-up"
        data-aos-delay="{{ animation_delay }}"
        data-aos-anchor="{{ animation_anchor }}"
        {% endif %}>
        {{ section.settings.description }}
      </p>
      {%- assign animation_delay = animation_delay | plus: 250 -%}
    {%- endif -%}

    {%- if link_text != blank or show_video_popup -%}
      <div class="hero__buttons">
        {%- if link_text != blank -%}
          <div class="hero__button"
            {% if transition_text %}
            data-aos="fade-up"
            data-aos-delay="{{ animation_delay }}"
            data-aos-anchor="{{ animation_anchor }}"
            {% endif %}>
            <a class="btn {{ btn_size }} {{ btn_style }} {{ btn_type }}" href="{{ section.settings.link }}">
              {{ link_text | escape }}
            </a>
          </div>
          {%- assign animation_delay = animation_delay | plus: 250 -%}
        {%- endif -%}

        {%- if show_video_popup -%}
          {%- assign video_parent_id = 'item-video-' | append: section.id -%}

          <div class="hero__button">
            <a href="{{ video_popup }}"
              class="video-button"
              {% if transition_text %}
              data-aos="fade-up"
              data-aos-delay="{{ animation_delay }}"
              data-aos-anchor="{{ animation_anchor }}"
              {% endif %}
              data-video-play="{%- render 'photoswipe-video-html' item_link: video_popup, item_id: video_parent_id -%}">
                {%- render 'icon-play' -%}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.link != blank -%}
    {%- unless link_text != blank -%}
      <a href="{{ section.settings.link }}" class="hero__content__link">&nbsp;</a>
    {%- endunless -%}
  {%- endif -%}
</div>

<div class="image-overlay"></div>

{%- if video_bg != blank -%}
  {%- liquid
    assign image_height_styles = ''
    assign padding_top = 1 | divided_by: video_bg.aspect_ratio | times: 100 | append: '%'
    capture image_height_styles
      if desktop_height == 'image-height'
        echo '--video-padding-top-desktop: ' | append: padding_top | append: '; '
      endif

      if mobile_height == 'image-height--mobile'
        echo '--video-padding-top-mobile: ' | append: padding_top | append: '; '
      endif
    endcapture
  -%}

  <div
    class="video-background {{ desktop_height }} {{ mobile_height }}"
    data-overflow-background
    {% if image_height_styles != '' %}style="{{ image_height_styles }}"{% endif %}>
    {{ video_bg | video_tag: autoplay: true, loop: true, muted: true }}
  </div>
{%- else -%}
  {%- liquid
    if image_mobile != blank
      assign desktop_image_modifier = 'desktop'

      capture mobile_image
        render 'image-hero', image: image_mobile, desktop_height: desktop_height, mobile_height: mobile_height, modifier: 'mobile'
      endcapture
    endif

    render 'image-hero', image: image, desktop_height: desktop_height, mobile_height: mobile_height,, modifier: desktop_image_modifier

    echo mobile_image
  -%}
{%- endif -%}