{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  assign variants_count = product.variants.size
  assign product_form_id = 'product_form_' | append: product.id | append: '--shop-bar'
  assign shop_bar = true

  if first_variant.available
    assign sold_out = false
  else
    assign sold_out = true
  endif
-%}

{%- style -%}
  /* ===== GPOD sticky ATC ===== */

  /* Dark, not white. A white bar on a white PDP reads as part of the page and
     disappears — which is exactly the complaint. Dark makes it the one
     persistent object on screen, and gives the green CTA maximum contrast. */
  .shop-bar {
    height: 76px;
    background: #0d0d0d;
    border-top: 0;
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.22);
    /* Above page content and the app widgets that sit around z-index 10-100.
       Deliberately BELOW Klaviyo's teaser (90000), which is moved out of the
       way instead — see the rule at the bottom of this block. */
    z-index: 200;
  }

  /* Mirrors .container exactly (same width calc and cap) so the bar's contents
     sit on the same inner line as the header card and every content block. */
  .shop-bar__inner {
    display: flex;
    /* row-reverse is required: the <form> is the FIRST child in the DOM, so
       plain `row` puts Add to Cart on the LEFT. Reversing sends the form to
       the right end and the product info to the left. */
    flex-flow: row-reverse nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: calc(100% - 80px);
    max-width: var(--gpod-page-max, 1380px);
    height: 100%;
    margin: 0 auto;
    padding: 0 32px;
  }

  .shop-bar__info {
    display: flex;
    align-items: center;
    flex: 0 1 auto;
    gap: 16px;
    border-right: 0;
    min-width: 0;
    overflow: hidden;
    color: #fff;
  }

  /* The thumbnail was rendering as a ~6px vertical sliver: the image is a tall
     product shot and nothing constrained the box, so it collapsed to its flex
     minimum. Fixed box, contained image, on a light tile so a dark product is
     still legible against the dark bar. */
  .shop-bar__images,
  .shop-bar__image {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
  }
  .shop-bar__images {
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }
  .shop-bar__image img,
  .shop-bar__image .image-wrapper {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .shop-bar__title {
    margin: 0;
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .shop-bar__price { padding-right: 0; }
  .shop-bar__price .product__price {
    margin-bottom: 0;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
  }
  .shop-bar__price .product__price__sale {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
  }

  .product__form--shop-bar { flex: 0 0 auto; }
  .product__form--shop-bar .product__form-submit {
    min-width: 260px;
    height: 52px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  /* Tablet + mobile: the theme hides the bar <=1023px. Reveal it, and stack
     the name over the price so the CTA keeps a full-size tap target. */
  @media only screen and (max-width: 1023px) {
    .shop-bar {
      display: flex !important;
      height: calc(72px + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
    }
    .shop-bar__inner {
      justify-content: space-between;
      max-width: none;
      gap: 12px;
      padding: 8px 16px;
    }
    .shop-bar__images { display: none; }
    .shop-bar__info {
      flex: 1 1 auto;
      min-width: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 1px;
    }
    .shop-bar__title {
      display: block;
      margin: 0;
      max-width: 100%;
      font-size: 13px;
      line-height: 1.25;
      color: rgba(255, 255, 255, 0.72);
      font-weight: 500;
    }
    .shop-bar__price .product__price {
      font-size: 17px;
      line-height: 1.2;
    }
    .product__form--shop-bar .product__form-submit {
      min-width: 0;
      padding: 0 26px;
      height: 48px;
      font-size: 15px;
    }
    .site-footer--push {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }

  @media only screen and (max-width: 767px) {
    .shop-bar {
      opacity: 1;
      visibility: visible;
      transition: transform 0.3s ease-in-out, opacity 0.3s linear, visibility 0s linear 0s;
    }
    /* Variant choices stay in the primary form on phones; the theme keeps the
       shop-bar variant ID synchronized. */
    .product__form--shop-bar .selector-wrapper {
      display: none;
    }
  }

  /* The "GET 15% OFF" tab is Klaviyo's teaser. It is z-index 90000 and pinned
     bottom-left, i.e. exactly on top of the product name and price in this
     bar, and no z-index we can set on a theme element will beat it. Moving it
     up is the only fix that keeps both. The class carries a generated hash
     (kl-teaser-RhFjbe), so it has to be matched on the prefix. */
  body:has(.shop-bar--is-visible) [class*="kl-teaser-"] {
    bottom: calc(88px + env(safe-area-inset-bottom)) !important;
    transition: bottom 0.3s ease-in-out;
  }

  /* :has() is well supported, but if it is not, an unconditional offset on
     product pages beats an overlap. */
  @supports not selector(:has(*)) {
    .template-product [class*="kl-teaser-"] {
      bottom: calc(88px + env(safe-area-inset-bottom)) !important;
    }
  }
{%- endstyle -%}

<div
  id="shop-bar"
  class="shop-bar"
  role="region"
  aria-label="{{ product.title | strip_html | escape }}"
  data-product-section-id="{{ section.id }}"
  data-scroll-lock-fill-gap
  data-shop-bar
>
  <div class="shop-bar__inner">
  {%- form 'product', product, class: 'product__form product__form--shop-bar', id: product_form_id -%}
    <div class="product__form-block">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}{%- comment -%} /partials/product-option.liquid {%- endcomment -%}
{%- capture selector_id -%}
	{%- if shop_bar -%}
		ShopBar-
	{%- else -%}
		Product-
	{%- endif -%}
	SingleOptionSelector-{{- forloop.index0 -}}-{{- product.id -}}
{%- endcapture -%}

<div class="selector-wrapper" data-option="option{{ option.position }}">
	<label for="{{ selector_id }}">
		{{- option.name -}}
	</label>

	<select
		id="{{ selector_id }}"
		name="options[{{ option.name | escape }}]"
		data-single-option-selector
		data-index="option{{ option.position }}">
		{%- for value in option.values -%}
			<option
				value="{{ value | escape }}"
				{% if option.selected_value == value %}selected="selected"{% endif %}>
				{{- value -}}
			</option>
		{%- endfor -%}
	</select>
	{%- render 'icon-arrow' -%}
</div>{%- endfor -%}
      {%- endunless -%}

      <label for="ShopBar-product-select--{{ section.id }}" class="accessible-label">{{ 'general.accessibility.select_variant' | t }}</label>
      {%- if variants_count > 1 -%}
        <select
          name="id"
          id="ShopBar-product-select--{{ section.id }}"
          class="product-single__variants"
          data-product-id="{{ product.id }}"
          data-product-select>
          {%- for variant in product.variants -%}
            {%- if variant.available -%}
              {%- liquid
                capture variant_price
                  if variant.price == 0
                    echo 'products.labels.free' | t
                  elsif settings.currency_code_enable
                    echo variant.price | money_with_currency
                  else
                    echo variant.price | money
                  endif
                endcapture
              -%}
              <option
                {% if variant == first_variant %} selected="selected" {% endif %}
                data-sku="{{ variant.sku }}"
                value="{{ variant.id }}">{{ variant.title }} - {{ variant_price }} </option>
            {%- else -%}
              <option disabled="disabled">{{ variant.title }} - {{ 'products.labels.sold_out' | t }}</option>
            {%- endif -%}
          {%- endfor -%}
        </select>
      {%- else -%}
        <input name="id" id="ShopBar-product-select--{{ section.id }}" data-product-id="{{ product.id }}" type="hidden" value="{{ first_variant.id }}">
      {%- endif -%}
    </div>

    <input type="hidden" name="quantity" value="1" data-quantity-field>
    <button type="button" data-add-to-cart hidden tabindex="-1" aria-hidden="true"></button>

    <div class="product__form-block">
      <button
        class="product__form-submit btn btn--solid btn--primary"
        type="submit"
        form="product_form_{{ product.id }}"
        data-gpod-shop-bar-submit
        {% if sold_out %}disabled{% endif %}
      >
        <span data-add-to-cart-text>
          {%- unless sold_out -%}
            {{- 'products.form.submit' | t -}}
          {% else %}
            {{- 'products.form.sold_out' | t -}}
          {%- endunless -%}
        </span>
        {%- render 'icon-check' -%}
      </button>
    </div>
  {%- endform -%}

  <div class="shop-bar__info">
    <div class="shop-bar__images">
      {%- if product.media.size > 0 -%}
        {%- for variant in product.variants -%}

          {%- assign image = variant.featured_image | default: featured_media.preview_image  -%}
          {%- assign is_shown = '' -%}

          {%- if variant.id == first_variant.id -%}
            {%- assign is_shown = 'shop-bar__image--shown' -%}
          {%- endif -%}

          <div class="shop-bar__image {{ is_shown }}"
            {% if variant.id == first_variant.id %} data-shop-bar-image-active {% endif %}
            data-variant-id="{{ variant.id }}">
            {%- render 'image' image: image, width: 96, sizes: '48px', aspect_ratio: 1, widths: '48, 96, 144, 192' -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="shop-bar__image shop-bar__image--shown">
          {%- comment -%} Show blank image if product has no media {%- endcomment -%}
          <div class="product-image product-image--empty"></div>
        </div>
      {%- endif -%}
    </div>

    <p class="shop-bar__title">{{ product.title | strip_html }}</p>

    <div class="shop-bar__price" aria-live="polite">{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if first_variant.compare_at_price > first_variant.price
    assign on_sale = true
  endif

  capture first_variant_price
    if first_variant.price == 0
      echo 'products.labels.free' | t
    elsif settings.currency_code_enable
      echo first_variant.price | money_with_currency
    else
      echo first_variant.price | money
    endif
  endcapture
-%}

<div class="product__price" data-price-wrapper>
  <span data-product-price>
    {{ first_variant_price }}
  </span>
  <s class="product__price__sale" data-compare-price>
    {%- if on_sale -%}
      {%- liquid
        if settings.currency_code_enable
          echo first_variant.compare_at_price | money_with_currency
        else
          echo first_variant.compare_at_price | money
        endif
      -%}
    {%- endif -%}
  </s>

  {%- liquid
    assign units = product.variants | map: 'unit_price' | compact
    if units[0]
      assign has_units = true
    else
      assign has_units = false
    endif
  -%}

  {%- if has_units -%}
    {%- unless first_variant.unit_price -%}
      {%- assign hide_units = ' hidden' -%}
    {%- endunless -%}

    {%- capture unit_price_separator -%}
      <span aria-hidden="true">/</span>
      <span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}</span>
    {%- endcapture -%}

    {%- capture unit_price_base_unit -%}
      <span>
        {%- if first_variant.unit_price_measurement -%}
          {%- if first_variant.unit_price_measurement.reference_value != 1 -%}
            {{ first_variant.unit_price_measurement.reference_value }}
          {%- endif -%}
          {{- first_variant.unit_price_measurement.reference_unit -}}
        {% endif %}
      </span>
    {%- endcapture -%}
    <div class="product__price__meta">
      <span class="product__unit-price{{ hide_units }}" data-product-unit>
        <span class="visually-hidden">{{ 'products.labels.unit_price_label' | t }}</span>
        <span data-product-unit-price id="unit-price-{{ section.id }}">{{ first_variant.unit_price | money }}</span>
        {{ unit_price_separator }}
        <span data-product-base id="unit-price-base-{{ section.id }}">{{ unit_price_base_unit }}</span>
      </span>
      <span data-price-each class="product__price--unit visually-hidden">
        {{ 'products.labels.each' | t }}
        <span data-price-each-amount></span>
      </span>
    </div>
  {% endif %}
</div></div>
  </div>
  </div>
</div>
<!-- end add-to-cart -->
