{%- comment -%}
  GPOD cart redesign: each line is a card (thumb / title + subtitle / remove,
  then quantity + line price). Rendered both in the cart and by
  sections/api-cart-items.liquid, which theme.js re-fetches after every cart
  change. theme.js hooks kept as-is: [data-item], the quantity stepper
  ([data-quantity-holder] etc.) and [data-item-remove] + data-id. The
  quantity field must stay the first <input> in each [data-item] — theme.js
  uses item.querySelector('input') to lock/reset it during updates.

  GPOD pre-order: lines for products tagged 'preorder-oct' get the
  gpod-line--preorder class (site-cart.liquid uses it to swap the
  "Ships within 1 business day" text) and a ship-date note.
{%- endcomment -%}
{%- for line_item in cart.items -%}
  {%- liquid
    if line_item.variant.title != 'Default Title'
      assign gpod_subtitle = line_item.variant.title
    else
      assign gpod_subtitle = line_item.product.type
    endif
  -%}
  <div class="gpod-line{% if line_item.product.tags contains 'preorder-oct' %} gpod-line--preorder{% endif %}" data-item>
    <a class="gpod-line__thumb" href="{{ collection_url }}{{ line_item.url }}" tabindex="-1" aria-hidden="true">
      {%- liquid
        assign image = line_item.image
        assign widths = '180, 220, 330'
        assign sizes = '96px'
        assign alt = image.alt | default: line_item.title

        render 'image' image: image, width: 220, sizes: sizes, widths: widths, alt: alt, aspect_ratio: 1, loading: 'eager', show_backfill: false, modifier: 'gpod-line__img'
      -%}
    </a>

    <div class="gpod-line__body">
      <div class="gpod-line__top">
        <div class="gpod-line__info">
          <a href="{{ collection_url }}{{ line_item.url }}" class="gpod-line__title">{{ line_item.product.title | strip_html }}</a>
          {%- if gpod_subtitle != blank -%}
            <span class="gpod-line__subtitle">{{ gpod_subtitle }}</span>
          {%- endif -%}

          {%- render 'gpod-preorder-ship', product: line_item.product, context: 'cart' -%}

          {%- unless line_item.selling_plan_allocation == nil -%}
            <span class="gpod-line__meta">
              {{- line_item.selling_plan_allocation.selling_plan.name -}}
            </span>
          {%- endunless -%}

          {%- assign property_size = line_item.properties | size -%}
          {%- if property_size > 0 -%}
            {%- for p in line_item.properties -%}
              {%- assign property_first_char = p.first | slice: 0 -%}
              {%- if p.last != blank and property_first_char != '_' -%}
                <span class="gpod-line__meta">
                  {{ p.first }}:
                  {% if p.last contains '/uploads/' -%}
                    <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                  {%- else -%}
                    {{ p.last }}
                  {%- endif %}
                </span>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" data-item-remove data-id="{{- line_item.key -}}" class="gpod-line__remove" aria-label="{{ 'cart.labels.remove' | t }} {{ line_item.product.title | strip_html | escape }}">
          {%- render 'icon-close' -%}
        </a>
      </div>

      <div class="gpod-line__bottom">
        <div class="counter input-group gpod-line__qty" data-quantity-holder>
          <input type="number" name="updates[]" id="updates_{{ line_item.key }}" class="inputCounter" data-quantity-field
        data-id="{{- line_item.key -}}" value="{{- line_item.quantity -}}" title="{{- 'products.form.quantity' | t }} - {{ line_item.product.title | strip_html -}}">
          <button class="inputCounter__btn inputCounter__btn--down" data-quantity-minus data-quantity-button type="button" aria-label="{{ 'general.accessibility.decrease' | t }}">
            {%- render 'icon-minus' -%}
          </button>
          <button class="inputCounter__btn inputCounter__btn--up" type="button" data-quantity-plus data-quantity-button aria-label="{{ 'general.accessibility.increase' | t }}">
            {%- render 'icon-plus' -%}
          </button>
        </div>

        <div class="gpod-line__price" data-price="{{ line_item.price }}">
          {%- if line_item.original_line_price > line_item.final_line_price -%}
            <s>{{ line_item.original_line_price | money }}</s>
          {%- endif -%}

          <span class="gpod-line__price-now">
            {%- if line_item.original_line_price == 0 -%}
              {{ 'products.labels.free' | t }}
            {%- else -%}
              {{ line_item.final_line_price | money }}
            {%- endif -%}
          </span>

          {%- if line_item.quantity > 1 and line_item.final_price > 0 -%}
            <span class="gpod-line__each">{{ line_item.final_price | money }} each</span>
          {%- endif -%}

          {%- if line_item.unit_price_measurement -%}
            <span class="gpod-line__each">
              {{- line_item.unit_price | money -}}
              <span aria-hidden="true">/</span><span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}</span>
              {%- if line_item.unit_price_measurement.reference_value != 1 -%}
                {{ line_item.unit_price_measurement.reference_value }}
              {%- endif -%}
              {{- line_item.unit_price_measurement.reference_unit -}}
            </span>
          {%- endif -%}
        </div>
      </div>

      {%- assign item_compare = line_item.variant.compare_at_price -%}
      {%- if item_compare > line_item.final_price -%}
        {%- assign item_savings = item_compare | minus: line_item.final_price -%}
        {%- assign line_savings = item_savings | times: line_item.quantity -%}
        <p class="gpod-line__savings">You save {{ line_savings | money }}</p>
      {%- endif -%}

      {%- if line_item.line_level_discount_allocations.size > 0 -%}
        <div class="gpod-line__discounts">
          {%- for discount_allocation in line_item.line_level_discount_allocations -%}
            <p>{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</p>
          {%- endfor -%}
        </div>
      {%- elsif line_item.discount_allocations.size > 0 -%}
        <div class="gpod-line__discounts">
          {%- for discount_allocation in line_item.discount_allocations -%}
            <p>{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</p>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endfor -%}