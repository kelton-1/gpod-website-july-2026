{% comment %} Site Navigation {% endcomment %}
{%- liquid
  assign mobile_menu_behaviour = settings.mobile_menu_behaviour
  assign menuPrimary = section.settings.menu_list
  assign image = section.settings.meganav_image
  assign image_heading = section.settings.meganav_image_heading
  assign image_link = section.settings.meganav_image_link
  assign image_aspect_ratio = 1 | divided_by: section.settings.image_aspect_ratio
  assign widths = '280, 320, 360, 420, 480, 560, 720, 840, 960'
  assign sizes = 'calc((100vw - 160px) * 0.29)'
  assign has_meganav = false

  if linklists[menuPrimary].levels == 3 and is_hamburger_nav == false
    assign has_meganav = true
  endif

  assign dropdown_id = 'NavDropdown'
  if is_hamburger_nav
    assign dropdown_id = 'NavMobileDropdown'
  endif
-%}

{%- if is_hamburger_nav -%}
  {%- comment -%}
    DRILL-DOWN NAVIGATION (the slide-in island / mobile drawer)

    Modular's stock hamburger nav is an accordion: tapping a parent expands
    its children in place, pushing everything below it down. With the redesign
    menu that is three levels deep (Shop > Monopods > GPOD X), so a shopper
    two levels in is scrolling a list of eighteen items and has lost any sense
    of where they are.

    This is the Arc pattern instead: each level is a full panel that slides in
    over the one before it, with a back button carrying the parent's name.
    One level visible at a time, position always legible.

    Rendered as its own branch rather than by patching the accordion markup
    below, for two reasons:
      1. `data-collapsible-trigger` / `data-collapsible-content` are what wire
         theme.js's accordion. Simply not emitting them is far more reliable
         than fighting listeners it has already bound — an earlier attempt to
         intercept the clicks in capture phase worked but left theme.js's
         inline max-height on the panels.
      2. The meganav branch below is only used by `.nav-standard`, which the
         desktop island hides. Leaving it untouched means reverting this is
         deleting one branch.

    Depth is capped at three levels because Shopify link lists are. The nested
    markup is written out rather than looped because Liquid has no recursion.

    Behaviour lives in assets/gpod.js (initNavDrilldown); styles in
    assets/gpod.css under "Navigation — drill-down panels".
  {%- endcomment -%}

  <div class="gpod-drill" data-gpod-drill>
    <ul class="menu gpod-drill__list" data-gpod-drill-root>
      {%- if menuPrimary != blank -%}
        {%- for link in linklists[menuPrimary].links -%}
          {%- assign l1 = 'drill-' | append: forloop.index0 -%}

          <li class="menu-item{% if link.levels > 0 %} has-submenu{% endif %}">
            {%- if link.levels > 0 -%}
              <button
                type="button"
                class="menu-item__link gpod-drill__open"
                data-gpod-drill-open="{{ l1 }}"
                aria-expanded="false"
                aria-controls="{{ dropdown_id }}--{{ l1 }}"
              >
                <span>{{ link.title | escape }}</span>
                {%- render 'icon-arrow' -%}
              </button>

              <div
                class="submenu gpod-drill__panel"
                id="{{ dropdown_id }}--{{ l1 }}"
                data-gpod-drill-panel="{{ l1 }}"
                aria-hidden="true"
              >
                <div class="gpod-drill__head">
                  <button type="button" class="gpod-drill__back" data-gpod-drill-back>
                    {%- render 'icon-arrow' -%}
                    <span>{{ link.title | escape }}</span>
                  </button>
                </div>

                <ul>
                  {%- comment -%}
                    A parent row is a button here, not a link, so the parent's
                    own page is only reachable if we offer it. Top-level items
                    that exist purely to group (url '#') have nothing to offer.
                  {%- endcomment -%}
                  {%- unless link.url == '#' or link.url == '#!' or link.url == blank -%}
                    <li class="submenu-item submenu-item--all">
                      <a class="submenu-item__link" href="{{ link.url }}">
                        View all
                      </a>
                    </li>
                  {%- endunless -%}

                  {%- for sublink in link.links -%}
                    {%- assign l2 = l1 | append: '-' | append: forloop.index0 -%}

                    <li class="submenu-item{% if sublink.levels > 0 %} has-submenu{% endif %}">
                      {%- if sublink.levels > 0 -%}
                        <button
                          type="button"
                          class="submenu-item__link gpod-drill__open"
                          data-gpod-drill-open="{{ l2 }}"
                          aria-expanded="false"
                          aria-controls="{{ dropdown_id }}--{{ l2 }}"
                        >
                          <span>{{ sublink.title | escape }}</span>
                          {%- render 'icon-arrow' -%}
                        </button>

                        <div
                          class="submenu gpod-drill__panel"
                          id="{{ dropdown_id }}--{{ l2 }}"
                          data-gpod-drill-panel="{{ l2 }}"
                          aria-hidden="true"
                        >
                          <div class="gpod-drill__head">
                            <button type="button" class="gpod-drill__back" data-gpod-drill-back>
                              {%- render 'icon-arrow' -%}
                              <span>{{ sublink.title | escape }}</span>
                            </button>
                          </div>

                          <ul>
                            {%- unless sublink.url == '#' or sublink.url == '#!' or sublink.url == blank -%}
                              <li class="submenu-item submenu-item--all">
                                <a class="submenu-item__link" href="{{ sublink.url }}">
                                  View all
                                </a>
                              </li>
                            {%- endunless -%}

                            {%- for subsublink in sublink.links -%}
                              <li class="submenu-item">
                                <a href="{{ subsublink.url }}" class="submenu-item__link visible-nav-link" data-visible-link>
                                  {{- subsublink.title | escape -}}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- else -%}
                        <a href="{{ sublink.url }}" class="submenu-item__link visible-nav-link" data-visible-link>
                          {{- sublink.title | escape -}}
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="menu-item__link" data-menu-item-link>
                {{- link.title | escape -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>

{%- else -%}

  <ul class="menu {% if has_meganav %}menu--has-meganav{% endif %}">
    {% comment %}
      Loop through the first link list.
    {% endcomment %}
    {%- if menuPrimary != blank -%}
      {%- for link in linklists[menuPrimary].links -%}
        {%- assign has_sub_menu = false -%}

        {%- for sublink in link.links -%}
          {%- if link.levels > 0 -%}
            {%- assign has_sub_menu = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign is_meganav = false -%}
        {%- if link.levels == 2 -%}
          {%- assign is_meganav = true -%}
        {%- endif -%}

        <li class="menu-item{% if has_sub_menu %} has-submenu{% endif %}{% if is_meganav %} menu-item--meganav{% elsif has_sub_menu %} menu-item--dropdown{% endif %}"{% if has_sub_menu %} data-dropdown-parent{% endif %}>
          <!-- LINKS -->
          <a href="{{ link.url }}" class="menu-item__link" data-menu-item-link>
            {{- link.title | escape -}}
          </a>
          {%- if has_sub_menu -%}
            <button class="toggle-submenu" aria-haspopup="true" aria-expanded="false" aria-label="{{ link.title | escape }}" aria-controls="{{ dropdown_id }}--{{ link.handle }}-{{ forloop.index0 }}" data-collapsible-trigger>
              {%- render 'icon-arrow' -%}
            </button>
          {%- endif -%}

          {%- if link.levels > 0 -%}
            {%- if is_meganav -%}
              <div class="megamenu-wrapper" id="{{ dropdown_id }}--{{ link.handle }}-{{ forloop.index0 }}">
                <div class="megamenu-inner" data-collapsible-content>
                  <div class="container">
            {%- endif -%}

            {%- capture submenuClass -%}
              {%- if is_meganav -%}
                submenu--items-{{ link.links.size }}
              {%- endif -%}
            {%- endcapture -%}

            {%- comment -%} MEGAMENU IMAGE AND TEXT {%- endcomment -%}
            {%- if is_meganav -%}
              {%- if image != blank or image_heading != blank -%}
                <div class="megamenu__image">
                  {%- if image != blank -%}
                    {%- capture megamenu_image -%}
                      {%- render 'image' image: image, sizes: sizes, widths: widths, aspect_ratio: image_aspect_ratio, modifier: 'megamenu__image-bg' -%}
                    {%- endcapture -%}

                    {%- unless image_link == blank -%}
                      <a href="{{ image_link }}" class="megamenu__image-inner">
                        {{- megamenu_image -}}
                      </a>
                    {%- else -%}
                      <div class="megamenu__image-inner">
                        {{- megamenu_image -}}
                      </div>
                    {%- endunless -%}
                  {%- endif -%}

                  {%- unless image_heading == blank -%}
                    <h4>
                      <span>
                        {%- if image_link != blank -%}
                          <a href="{{ image_link }}">{{ image_heading }}</a>
                        {%- else -%}
                          {{- image_heading -}}
                        {%- endif -%}
                      </span>
                    </h4>
                  {%- endunless -%}
                </div>
              {%- endif -%}
            {%- endif -%}
            {%- comment -%} END MEGANAV IMAGE AND TEXT {%- endcomment -%}

            <div class="submenu{% unless is_meganav %} submenu--dropdown{% endunless %} {{ submenuClass }}"{% unless is_meganav %} id="{{ dropdown_id }}--{{ link.handle }}-{{ forloop.index0 }}"{% endunless %}>
              <ul data-collapsible-content>
                {%- comment -%} SUBMENU LINKS {%- endcomment -%}
                {%- for sublink in link.links -%}
                  <li data-levels = "{{ sublink.levels }}" class="submenu-item{% if sublink.levels > 0 %} has-submenu{% endif %}">
                    {%- comment -%} SUBLINK TITLE {%- endcomment -%}
                    <a class="submenu-item__link visible-nav-link{% if is_meganav %} submenu-item__title{% endif %}" href="{{ sublink.url }}" data-visible-link{% if has_sub_menu %} aria-expanded="false" aria-haspopup="true"{% endif %}>
                      {{- sublink.title -}}
                    </a>

                    {%- if sublink.levels > 0 -%}
                    <div class="submenu"{% unless is_meganav %} id="{{ dropdown_id }}--{{ link.handle }}-{{ sublink.handle }}-{{ forloop.index0 }}"{% endunless %}>
                      <ul data-collapsible-content>
                        {%- comment -%} SUB-SUBMENU LINKS {%- endcomment -%}
                        {%- for subsublink in sublink.links -%}
                          <li class="submenu-item">
                            <a href="{{ subsublink.url }}" class="submenu-item__link visible-nav-link" data-visible-link>{{ subsublink.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                    {%- endif -%}
                   </li>
                  {%- comment -%} END SUBSUBLINK {%- endcomment -%}
                {%- endfor -%}
              </ul>
            </div>

            {%- if is_meganav -%}
                  </div>
                </div>
              </div>
              {%- comment -%} END MEGAMENU WRAPPER {%- endcomment -%}
            {%- endif -%}
          {%- endif -%}

        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>

{%- endif -%}

{%- if is_hamburger_nav -%}
  <div class="nav-user">
    <ul>
      {%- if shop.customer_accounts_enabled -%}
        {%- if customer -%}
          <li class="nav-user__item nav-user__item--account"><a href="{{ routes.account_url }}" class="nav-user__link">{{ 'customer.link.my_account' | t }}</a></li>
        {%- else -%}
          <li class="nav-user__item nav-user__item--account"><a href="{{ routes.account_login_url }}" class="nav-user__link">{{ 'customer.link.login' | t }}</a></li>
        {%- endif -%}
      {%- endif -%}

      {%- if settings.show_search -%}
        <li class="nav-user__item nav-user__item--search"><a href="{{ routes.search_url }}" class="nav-user__link">{{ 'general.slide_out_navigation.search_label' | t }}</a></li>
      {%- endif -%}
    </ul>
  </div>

  {%- render 'social-links' social_class: 'nav-footer', social_inner_class: 'nav-social', social_list_class: 'social-links social-links--nav' -%}
{%- endif -%}
