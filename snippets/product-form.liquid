</div>{%- else -%}{%- comment -%} /partials/product-option.liquid {%- endcomment -%}
{%- capture selector_id -%}
	{%- if shop_bar -%}
		ShopBar-
	{%- else -%}
		Product-
	{%- endif -%}
	SingleOptionSelector-{{- forloop.index0 -}}-{{- product.id -}}
{%- endcapture -%}

<div class="selector-wrapper" data-option="option{{ option.position }}">
	<label for="{{ selector_id }}">
		{{- option.name -}}
	</label>

	<select
		id="{{ selector_id }}"
		name="options[{{ option.name | escape }}]"
		data-single-option-selector
		data-index="option{{ option.position }}">
		{%- for value in option.values -%}
			<option
				value="{{ value | escape }}"
				{% if option.selected_value == value %}selected="selected"{% endif %}>
				{{- value -}}
			</option>
		{%- endfor -%}
	</select>
	{%- render 'icon-arrow' -%}
</div>{%- endif -%}

        {%- endfor -%}
      {%- endif -%}
    {%- endunless -%}

    <label for="product-select--{{ section.id }}" class="accessible-label">{{ 'general.accessibility.select_variant' | t }}</label>

    {%- if variants_count > 1 -%}
      <select
        name="id"
        id="product-select--{{ section.id }}"
        class="product-single__variants"
        data-product-id="{{ product.id }}"
        data-product-select>
        {%- for variant in product.variants -%}
          {%- liquid
            capture variant_price
              if variant.price == 0
                echo 'products.labels.free' | t
              elsif settings.currency_code_enable
                echo variant.price | money_with_currency
              else
                echo variant.price | money
              endif
            endcapture
          -%}
          <option
            {% if variant == first_variant %} selected="selected" {% endif %}
            {% unless variant.available %} disabled="disabled" {% endunless %}
            data-sku="{{ variant.sku }}"
            value="{{ variant.id }}">
            {{ variant.title }} - 
            {% if variant.available %}
              {{ variant_price }}
            {% else %}
              {{ 'products.labels.sold_out' | t }}
            {% endif %}
          </option>
        {%- endfor -%}
      </select>
    {%- else -%}
      <input name="id" id="product-select--{{ section.id }}" data-product-id="{{ product.id }}" type="hidden" value="{{ first_variant.id }}">
    {%- endif -%}
  </div>

  <div class="product__form-block">
    <div class="qty__adjust" data-quantity-holder>
      <label for="quantity--{{ section.id }}" class="accessible-label">{{ 'general.accessibility.quantity_selector' | t }}</label>
      <input type="number" class="qty__adjust-input" name="quantity" id="quantity--{{ section.id }}" value="1" min="1" data-quantity-field>

      <button type="button" class="qty__adjust-btn qty__adjust-btn--minus" aria-label="{{ 'general.accessibility.decrease' | t }}" data-quantity-minus data-quantity-button>{% render 'icon-minus' %}</button>
      <button type="button" class="qty__adjust-btn qty__adjust-btn--plus" aria-label="{{ 'general.accessibility.increase' | t }}" data-quantity-plus data-quantity-button>{% render 'icon-plus' %}</button>
    </div>

    {%- if gift_card_recipient_feature_active -%}
      {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
    {%- endif -%}

    <div class="product__form-buttons">
      {%- comment -%}
        Add to Cart is ALWAYS solid. Modular demotes it to `btn--outline`
        whenever the Shop Pay button is shown, which handed the buy box's
        visual primary to Shopify's branded purple and left the GPOD accent
        absent from the single most important control on the site.

        It also broke legibility once the accent became green: an outline
        primary draws both border and text from --BTN-PRIMARY-BORDER-COLOR,
        so Add to Cart rendered green-on-white at 2.03:1.

        Solid green measures 9.32:1 and matches how arc.cc leads its buy box.
        Shop Pay is unchanged and still sits directly below as express
        checkout — this is a hierarchy change, not a removal.
      {%- endcomment -%}
      <button
        class="product__form-submit btn btn--primary btn--solid"
        type="submit"
        name="add"
        data-ajax="{{ settings.enable_ajax_cart }}"
        data-handle="{{ product.handle }}"
        {% if sold_out %}disabled{% endif %}
        data-focus-element
        data-add-to-cart>
        <span data-add-to-cart-text>
          {%- if sold_out -%}
            {{- 'products.form.sold_out' | t -}}
          {%- else -%}
            {%- if preorder -%}
              {{- 'products.form.preorder' | t -}}
            {%- else -%}
              {{- 'products.form.submit' | t -}}
            {%- endif -%}
          {%- endif -%}
        </span>
        {%- render 'icon-check' -%}
      </button>
    </div>

    {%- if show_payment_buttons -%}
      <div class="product__form-buttons" data-payment-button="{{ enable_payment_button }}" data-payment-button-quickview="{{ settings.enable_payment_button }}">
        {{- form | payment_button -}}
      </div>
    {%- endif -%}
  </div>
{%- endform -%}