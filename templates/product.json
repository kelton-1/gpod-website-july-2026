    "pdp_howto": {
      "type": "pdp-how-to",
      "blocks": {
        "step_extend": {
          "type": "step",
          "settings": {
            "title": "Extend from the top down",
            "text": "Twist each lock a quarter turn to loosen, pull the section out, then twist back to lock. Always extend the upper sections first and never slam the GPOD into the ground while collapsed — that's what jams the lower section."
          }
        },
        "step_attach": {
          "type": "step",
          "settings": {
            "title": "Attach your phone",
            "text": "iPhones with MagSafe snap straight on. Android or thick cases: stick one of the included metal plates on first — it holds just as strong."
          }
        },
        "step_film": {
          "type": "step",
          "settings": {
            "title": "Frame your swing and film",
            "text": "Stake it down-target or face-on, tilt the ball head to frame yourself, and record. With a Bluetooth remote, pair it in your phone's Bluetooth settings and the button triggers your camera shutter."
          }
        }
      },
      "block_order": [
        "step_extend",
        "step_attach",
        "step_film"
      ],
