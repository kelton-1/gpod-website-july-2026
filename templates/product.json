    "pdp_howto": {
      "type": "pdp-how-to",
      "blocks": {
        "step_extend": {
          "type": "step",
          "settings": {
            "title": "Set your height",
            "text": "GPOD X: a quarter turn on each cam lock, extend, turn it back. Pauly P: twist the oversized ring and slide. The original GPOD is a fixed 41 in, so there is nothing to set."
          }
        },
        "step_attach": {
          "type": "step",
          "settings": {
            "title": "Snap your phone on",
            "text": "The GPUCK is already mounted on the ball head. An iPhone with MagSafe goes straight on; for anything else, stick one of the three included metal plates to your phone or case first."
          }
        },
        "step_film": {
          "type": "step",
          "settings": {
            "title": "Angle it, then hit",
            "text": "The ball joint turns a full 360°, so you can set down-the-line, face-on or an overhead putting view and leave it there. Hit record and swing."
          }
        },
        "step_plant": {
          "type": "step",
          "settings": {
            "title": "Plant it",
            "text": "Push the stake into the turf until it feels firm — a few inches is plenty. On mats, tile or a sim floor, screw on the GPOD Base 2.0 instead."
          }
        }
      },
      "block_order": [
        "step_plant",
        "step_extend",
        "step_attach",
