    /* Replaced the four-up credibility band on 2026-07-31. Four equal icon
       cards made four claims of equal weight, which is the most generic
       module on a Shopify homepage — restyling it was not going to fix that.
       One number, drawn to true proportion, carries more.

       Weights are the corrected figures from the spec sheet: GPOD 4.8 oz (NOT
       the 4.4 oz printed on the old comparison slide), iRangeSports Stick EXT
       27.2 oz. Keep both bar values in oz — the bars are proportional. */
    "proof": {
      "type": "gpod-stat-band",
      "blocks": {
        "bar_gpod": {
          "type": "bar",
          "settings": {
            "label": "GPOD",
            "value": "4.8",
            "unit": "oz",
            "highlight": true
          }
        },
        "bar_alt": {
          "type": "bar",
          "settings": {
            "label": "Aluminum alignment-stick mount",
