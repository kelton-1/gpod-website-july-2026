    "brand_statement": {
      "type": "home-brand-statement",
      "settings": {
        "kicker": "Why GPOD exists",
        "statement": "Capturing the moment shouldn’t get in the way of the moment.",
        "text": "<p>Whether you’re filming a golf swing, coaching a student, or creating content on the move, your gear should work with you — not against you.</p><p>I created GPOD after years of dealing with unstable tripods, awkward phone clamps, and missed shots caused by slow, frustrating setups. There had to be a better way.</p><p>GPOD was designed to set up in seconds, stay put in tough conditions, and let you focus on what you’re actually there to do.</p><p><strong>Less time setting up. More time creating.</strong></p>",
        "signature": "— Paul Park",
        "signature_role": "Founder",
        "layout": "letter",
        "color_style": "dark",
        "padding_top": 84,
        "padding_bottom": 84
      }
    },
