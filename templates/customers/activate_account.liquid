<section class="account-page">
  <div class="container">
    <div class="account-activation__wrapper row inline u-center">
      <h1 class="u-center">{{ 'customer.activate_account.title' | t }}</h1>

      <p class="u-center c-error">{{ 'customer.activate_account.subtext' | t }}</p>

      {% comment %}
        This form must use 'activate_customer_password'
      {% endcomment %}
      <div class="account-form">
        {%- form 'activate_customer_password' -%}
          <div class="account-activation__errors h4">
            {{- form.errors | default_errors -}}
          </div>

          <div class="account-activation__form-fields grid">
            <div class="input-group">
              <label for="CustomerPassword" class="h4 c-gray">{{ 'customer.activate_account.password' | t }}</label>

              <input type="password" value="" name="customer[password]" id="CustomerPassword" class="h4">
            </div>

            <div class="input-group">
              <label for="CustomerPasswordConfirmation" class="h4 c-gray">{{ 'customer.activate_account.password_confirm' | t }}</label>

              <input type="password" value="" name="customer[password_confirmation]" id="CustomerPasswordConfirmation" class="h4">
            </div>
          </div>

          <div class="account-activation__buttons u-center">
            <button type="submit" class="btn btn--solid btn--primary">{{ 'customer.activate_account.submit' | t }}</button>

            <button type="submit" class="btn btn--solid btn--secondary" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>