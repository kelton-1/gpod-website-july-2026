<section class="account-page" data-account-form>
  <div class="container">
    <div class="account-page__recover-form recoverForm account-form is-hidden" id="recover-form" data-recover-password>
      <p class="account-form__heading size--heading-1">{{ 'customer.recover_password.title' | t }}</p>

      <p class="account-form__info-text">{{ 'customer.recover_password.subtext' | t }}</p>

      <div class="account-form__recover-form">
        {%- form 'recover_customer_password' -%}
          {%- assign recover_success = form.posted_successfully? -%}

          <div class="row inline">
            {{ form.errors | default_errors }}

            <div class="input-group">
              <label for="RecoverEmail" class="c-gray">{{ 'customer.recover_password.email' | t }}</label>

              <input type="email" name="email" id="RecoverEmail" autocorrect="off" autocapitalize="off" required>
            </div>
          </div>

          <div class="row inline">
            <button type="submit" class="account-form__submit btn btn--solid btn--primary">{{ 'customer.recover_password.submit' | t }}</button>

            <div class="account-form__links">
              <a href="#login-form" class="account-form__link" data-hide-reset>{{ 'customer.recover_password.cancel' | t }}</a>
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>

    <div class="account-page__login-form account-form is-hidden" id="login-form" data-login-form>
      {%- form 'customer_login' -%}
        <div class="row inline">
          {%- if recover_success -%}
            <div class="row inline u-center">
              <div class="size--heading-3" id="ResetSuccess">
                {{- 'customer.recover_password.success' | t -}}
              </div>
            </div>
          {%- endif -%}

          <p class="size--heading-1">{{ 'customer.login.title' | t }}</p>

          <div class="p c-error">
            {{- form.errors | default_errors -}}
          </div>

          <div class="account-form__login-inputs">
            <div class="input-group">
              <label for="CustomerEmail" class="c-gray">{{ 'customer.login.email' | t }}</label>

              <input type="email" name="customer[email]" id="CustomerEmail" class="{% if form.errors contains 'email' %} error{% endif %}" autocorrect="off" autocapitalize="off" autofocus required>
            </div>

            {% if form.password_needed %}
              <div class="input-group">
                <label for="CustomerPassword" class="c-gray">{{ 'customer.login.password' | t }}</label>

                <input type="password" name="customer[password]" id="CustomerPassword" class="{% if form.errors contains 'password' %} error{% endif %}" required>

                <a href="#recover-form" class="account-form__link account-form__link--password" data-show-reset>{{ 'customer.login.forgot_password' | t }}</a>
              </div>
            {% endif %}
          </div>
        </div>

        <button type="submit" class="account-form__submit btn btn--solid btn--primary">{{ 'customer.login.sign_in' | t }}</button>
      {%- endform -%}

      {%- if shop.checkout.guest_login -%}
        {%- form 'guest_login' -%}
          <button type="submit" class="guest-login-submit btn btn--solid btn--secondary">{{ 'customer.login.guest_continue' | t }}</button>
        {%- endform -%}
      {%- endif -%}

      <div class="account-form__links">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_register_url }}" class="account-form__link">{{ 'customer.link.create_account' | t }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>