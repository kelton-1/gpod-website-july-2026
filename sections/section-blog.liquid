{% comment %} Settings {% endcomment %}
{%- liquid
  assign blog = blogs[section.settings.blog]
  assign blog_link = blogs[section.settings.blog].url | default: '#'
  assign title = section.settings.heading
  assign text = section.settings.blog_text
  assign cta = section.settings.cta
  assign btn_size = section.settings.btn_size
  assign btn_style = section.settings.btn_style
  assign btn_type = section.settings.btn_type

  assign article_rows = section.settings.article_rows | plus: 0
  assign article_columns = section.settings.article_columns | plus: 0
  assign articles_count = article_columns | times: article_rows
-%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
  --COLUMNS: {{ article_columns }};
{%- endcapture -%}

{%- comment -%} Section {%- endcomment -%}
<section
  id="blog-module-{{ section.id }}"
  class="blog-module container-wrap section-padding"
  data-section-id="{{ section.id }}"
  data-section-type="featured-blog"
  data-blog-container
  style="{{ style }}"
>
  {%- unless title == blank and text == blank -%}
    <div class="page-title">
      <div class="container">
        {%- if title != blank -%}
          <h2>{{ title }}</h2>
        {%- endif -%}
        {%- if text != blank -%}
          {{ text }}
        {%- endif -%}
      </div>
    </div>
  {%- endunless -%}

  <div class="blog-module-posts__wrapper">
    <div class="blog-module-posts blog-module-posts--horizontal grid" data-blog-posts>
      {%- if section.settings.blog == blank -%}
        {%- for i in (1..articles_count) -%}
          {%- render 'blog-post', blog: blog, article: article, article_columns: article_columns, index: forloop.index, onboarding: true -%}
        {%- endfor -%}
      {%- else -%}
        {%- for article in blog.articles limit: articles_count -%}
          {%- render 'blog-post', blog: blog, article: article, article_columns: article_columns, index: forloop.index, onboarding: false -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  {%- if cta != blank -%}
    <div class="row row-med u-center button-wrapper">
      <a href="{{ blog_link }}" class="btn {{ btn_size }} {{ btn_style }} {{ btn_type }}">{{ cta }}</a>
    </div>
  {%- endif -%}
</section>

{% comment %} Schema {% endcomment %}
{% schema %}
  {
    "name": "Blog posts",
    "class": "shopify-section--featured-blog",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "blog_text",
        "label": "Text"
      },
      {
        "type": "blog",
        "id": "blog",
        "label": "Blog"
      },
      {
        "type": "text",
        "id": "cta",
        "label": "Button label",
        "default": "View all posts",
        "info": "Links to blog"
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Color",
        "default": "btn--primary",
        "options": [
          { "label": "Primary", "value": "btn--primary" },
          { "label": "Secondary", "value": "btn--secondary" },
          { "label": "White", "value": "btn--white" },
          { "label": "Black", "value": "btn--black" }
        ]
      },
      {
        "type": "select",
        "id": "btn_size",
        "label": "Size",
        "default": "",
        "options": [
          { "label": "Small", "value": "btn--small" },
          { "label": "Medium", "value": "" },
          { "label": "Large", "value": "btn--large" }
        ]
      },
      {
        "type": "select",
        "id": "btn_style",
        "label": "Style",
        "default": "btn--solid",
        "options": [
          { "label": "Solid", "value": "btn--solid" },
          { "label": "Outline", "value": "btn--outline" },
          { "label": "Text", "value": "btn--text" }
        ]
      },
      {
        "type": "header",
        "content": "Settings"
      },
      {
        "type": "checkbox",
        "id": "tags",
        "label": "Show tags",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "author",
        "label": "Show author",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "date",
        "label": "Show date",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_comments",
        "label": "Show comment count",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_excerpt",
        "label": "Show excerpt",
        "default": true
      },
      {
        "type": "range",
        "id": "image_aspect_ratio",
        "label": "Image aspect ratio",
        "min": 0.5,
        "max": 1.5,
        "step": 0.1,
        "unit": ":1",
        "default": 1
      },
      {
        "type": "range",
        "id": "article_rows",
        "label": "Number of rows",
        "default": 1,
        "min": 1,
        "max": 4,
        "step": 1
      },
      {
        "type": "range",
        "id": "article_columns",
        "label": "Articles per row",
        "default":4,
        "min":2,
        "max":5,
        "step":1
      },
      {
        "type": "header",
        "content": "Section padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding top",
        "default": 50
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding bottom",
        "default": 50
      }
    ],
    "presets": [
      {
        "category": "Blog",
        "name": "Blog posts",
        "settings": {
          "blog": "news",
          "heading": "News"
        }
      }
    ],
    "disabled_on": {
      "groups": ["header", "footer"]
    }
  }
{% endschema %}
