{% comment %}
  PDP: "Ways to use it" — Huckberry's "Ways to Wear It", adapted. A
  scroll-snap row of use-case cards (grid on wide screens up to six),
  each showing a setting with a label, caption, optional photo and link.

  Content-pending convention: the section renders NOTHING until at least
  one block has content, so it can ship wired into the product template
  before that content exists (same pattern as pdp-pairs-with).

  A card needs a label OR a photo — not both. The original rule was
  photo-only, which meant a product with real, written use cases could not
  show them until a shoot happened. Pocket G is exactly that case: the
  Playbook lists six use cases for it (Golf / Travel / Sports / Work /
  Fitness / Content Creation) and none of them have lifestyle photography
  yet. Text-first cards ship the content now and upgrade in place the
  moment a photo is dropped into the block — no template rework.
{% endcomment %}

{%- liquid
  assign visible = 0
  for block in section.blocks
    if block.settings.image != blank or block.settings.label != blank
      assign visible = visible | plus: 1
    endif
  endfor

  comment
    Column count follows the content: 5 or 6 cards read better as three
    across two rows than as one very thin row of six.
  endcomment
  assign cols = visible
  if visible > 4
    assign cols = 3
  endif
-%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
  --WAYS-COLS: {{ cols }};
{%- endcapture -%}

{%- if visible > 0 -%}
<section class="gpod-section gpod-ways container-wrap section-padding"
  data-section-type="pdp-ways-to-use"
  style="{{ style }}"
>
  <div class="container">
    {%- if section.settings.kicker != blank -%}
      <p class="gpod-kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="gpod-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="gpod-lede">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="gpod-ways__track{% if visible <= 6 %} gpod-ways__track--grid{% endif %}" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank or block.settings.label != blank -%}
          {%- assign tag = 'div' -%}
          {%- if block.settings.link != blank -%}
            {%- assign tag = 'a' -%}
          {%- endif -%}
          <{{ tag }}{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %} class="gpod-ways__card{% if block.settings.image == blank %} gpod-ways__card--text{% endif %}" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
            <div class="gpod-ways__media">
              <img
                src="{{ block.settings.image | image_url: width: 520 }}"
                srcset="{{ block.settings.image | image_url: width: 380 }} 380w, {{ block.settings.image | image_url: width: 520 }} 520w, {{ block.settings.image | image_url: width: 760 }} 760w"
                sizes="(min-width: 1024px) 300px, 70vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                alt="{{ block.settings.label | default: section.settings.heading | escape }}"
              >
            </div>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <h3 class="gpod-ways__label">{{ block.settings.label | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="gpod-ways__caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
            {%- if tag == 'a' and block.settings.link_text != blank -%}
              <span class="gpod-ways__cta">{{ block.settings.link_text | escape }} →</span>
            {%- endif -%}
          </{{ tag }}>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- comment -%}
      The hint is mobile-only in CSS, and on mobile the row is always a
      scroller whatever the count — so it belongs on any multi-card row,
      not on the desktop grid-overflow threshold it used to be tied to.
    {%- endcomment -%}
    {%- if visible > 1 -%}
      <p class="gpod-compare__hint gpod-compare__hint--mobile">Swipe for more →</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "PDP ways to use it",
  "class": "shopify-section--pdp-ways-to-use",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "One GPOD, every setting"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ways to use it"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "way",
      "name": "Way to use it",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Optional. The card shows as soon as it has a Setting label; adding a photo upgrades it. Any ratio works — it crops to 4:5."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Setting",
          "info": "Required — the card is hidden without it. e.g. 'Range days', 'Sim room', 'On the road'"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "One line on how it's set up here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link label",
          "default": "Shop this setup"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Product",
      "name": "PDP ways to use it",
      "blocks": [
        { "type": "way" },
        { "type": "way" },
        { "type": "way" },
        { "type": "way" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
