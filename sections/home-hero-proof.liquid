{%- comment -%}
  Home hero + trust cards — Tenscope Round 2 (mobile frame 100:216, desktop 28:1595).
  Pill → H1 → one line → full-width green CTA, then a rail of trust cards
  (horizontal scroll on phones, 4-up grid ≥1024px).

  Paul's board comments applied: still image rather than video (#8 thread),
  the image must show the monopod in action (#9), trust card reads
  "5.0 rating + review count" (#10), cards optimised for mobile (#11),
  body copy shortened (#8: "the copy is way too long").

  Styles: assets/gpod-ts.css §1.
{%- endcomment -%}

{{ 'gpod-ts.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img_m = section.settings.image_mobile | default: section.settings.image
  assign img_d = section.settings.image
  assign trust_count = section.blocks.size
-%}

{%- capture style -%}
  --ts-hero-h-m: {{ section.settings.height_mobile }}px;
  --ts-hero-h-d: {{ section.settings.height_desktop }}px;
  --ts-hero-dim: {{ section.settings.overlay | divided_by: 100.0 }};
  --ts-hero-pos-m: {{ section.settings.focal_mobile }};
  --ts-hero-pos-d: {{ section.settings.focal_desktop }};
  --ts-hero-top: {{ section.settings.top_space_mobile }}px;
  --ts-hero-top-d: {{ section.settings.top_space_desktop }}px;
  --ts-trust-n: {{ trust_count | at_least: 1 }};
{%- endcapture -%}

<section class="ts ts-hero" style="{{ style | strip_newlines }}" data-section-id="{{ section.id }}" data-section-type="home-hero-proof">
  {%- if img_m != blank -%}
    <div class="ts-hero__media ts-hero__media--mobile">
      {{- img_m | image_url: width: 1200 | image_tag:
          widths: '430, 640, 860, 1200',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: '' -}}
    </div>
  {%- endif -%}
  {%- if img_d != blank -%}
    <div class="ts-hero__media ts-hero__media--desktop">
      {{- img_d | image_url: width: 2400 | image_tag:
          widths: '1024, 1440, 1920, 2400',
          sizes: '100vw',
          loading: 'eager',
          alt: '' -}}
    </div>
  {%- endif -%}
  <div class="ts-hero__scrim" aria-hidden="true"></div>

  <div class="ts-wrap ts-hero__content">
    {%- if section.settings.pill != blank -%}
      <p class="ts-hero__pill">
        <span class="ts-icon-tile">{% render 'ts-icon', name: 'plus' %}</span>
        {{ section.settings.pill | escape }}
      </p>
    {%- endif -%}

    <h1 class="ts-h1 ts-hero__title">{{ section.settings.heading | escape }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="ts-body ts-hero__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="ts-hero__cta">
        <a class="ts-btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          {{- section.settings.cta_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ts-wrap ts-hero__trust">
      <ul class="ts-track" role="list" aria-label="{{ section.settings.trust_label | escape }}" tabindex="0">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a class="ts-trust" href="{{ block.settings.link }}">{%- else -%}<div class="ts-trust">{%- endif -%}
              <span class="ts-icon-tile">{% render 'ts-icon', name: block.settings.icon %}</span>
              <span class="ts-trust__label">{{ block.settings.label | escape }}</span>
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero + trust cards",
  "class": "shopify-section--ts-hero",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Show the GPOD in use — a cold visitor should see what it is." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Optional portrait crop. Falls back to the desktop image." },
    { "type": "text", "id": "focal_desktop", "label": "Desktop focal point", "default": "50% 50%", "info": "CSS object-position, e.g. 40% 60%" },
    { "type": "text", "id": "focal_mobile", "label": "Mobile focal point", "default": "50% 50%" },
    { "type": "range", "id": "overlay", "label": "Darken image", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 20 },
    { "type": "range", "id": "height_mobile", "label": "Min height (mobile)", "min": 480, "max": 900, "step": 10, "unit": "px", "default": 640 },
    { "type": "range", "id": "height_desktop", "label": "Min height (desktop)", "min": 560, "max": 1000, "step": 10, "unit": "px", "default": 830 },
    { "type": "range", "id": "top_space_mobile", "label": "Space for header (mobile)", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "top_space_desktop", "label": "Space for header (desktop)", "min": 40, "max": 240, "step": 4, "unit": "px", "default": 152 },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "pill", "label": "Trust pill", "default": "Trusted by 75,000+ golfers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Film your golf swing in seconds" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Set your angle, snap on your phone, and swing." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "trust_label", "label": "Trust cards accessible name", "default": "Why golfers trust GPOD" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust card",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "package",
          "options": [
            { "value": "package", "label": "Package (returns)" },
            { "value": "seal-check", "label": "Seal (warranty)" },
            { "value": "star", "label": "Star (reviews)" },
            { "value": "magnet", "label": "Magnet (MagSafe)" },
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "shield", "label": "Shield" },
            { "value": "golfer", "label": "Golfer" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label", "default": "14-day returns" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero + trust cards",
      "blocks": [
        { "type": "trust", "settings": { "icon": "package", "label": "14-day returns" } },
        { "type": "trust", "settings": { "icon": "seal-check", "label": "1-year warranty" } },
        { "type": "trust", "settings": { "icon": "star", "label": "5.0 rating • +561 Reviews" } },
        { "type": "trust", "settings": { "icon": "magnet", "label": "Works with MagSafe" } }
      ]
    }
  ]
}
{% endschema %}
