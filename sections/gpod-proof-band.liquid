{% comment %}
  Credibility band — replaces `section-icons-row` on the homepage.

  What was wrong with the old band:
  - icons came from Modular's generic set and did not match the statements
    (a trophy for PREMIUM MATERIALS, a phone for JUST STICK IT AND SWING IT)
  - it sat on a solid #8AC663 background with #333 body text, a 6.24:1
    combination that read muddy rather than crisp
  - green as a background competed with green as the CTA colour

  What changed:
  - purpose-drawn icons (snippets/gpod-proof-icon.liquid)
  - light surface, near-black type, and green reserved for the icon strokes,
    which inverts the relationship and is what makes it read sharply
  - an optional supporting stat per item, because "It's really that easy."
    was carrying no weight as a third claim

  Styles: assets/gpod.css under "Credibility band".
{% endcomment %}

{%- capture style -%}
  --proof-pt: {{ section.settings.padding_top }}px;
  --proof-pb: {{ section.settings.padding_bottom }}px;
  --proof-bg: {{ section.settings.background_color }};
  --proof-ink: {{ section.settings.heading_color }};
  --proof-text: {{ section.settings.text_color }};
  --proof-icon: {{ section.settings.icon_color }};
{%- endcapture -%}

<section
  class="gpod-proof gpod-proof--{{ section.settings.layout }}"
  data-section-id="{{ section.id }}"
  data-section-type="proof-band"
  style="{{ style }}"
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="gpod-proof__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="gpod-proof__grid">
        {%- for block in section.blocks -%}
          <li class="gpod-proof__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="gpod-proof__icon" aria-hidden="true">
                {%- render 'gpod-proof-icon', icon: block.settings.icon -%}
              </span>
            {%- endif -%}

            {%- if block.settings.stat != blank -%}
              <p class="gpod-proof__stat">{{ block.settings.stat | escape }}</p>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="gpod-proof__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="gpod-proof__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Credibility band",
  "class": "shopify-section--proof-band",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank for a bare icon row."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "cards",
      "options": [
        { "label": "Cards", "value": "cards" },
        { "label": "Plain row", "value": "plain" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "paragraph",
      "content": "Keep the background light. The previous band used solid brand green behind grey text (6.24:1), which read muddy and competed with the green CTA colour. Green now lives on the icons only."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f6f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icons",
      "default": "#8AC663"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Claim",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "carbon",
          "options": [
            { "label": "Carbon weave", "value": "carbon" },
            { "label": "Rotating head", "value": "rotate" },
            { "label": "Stake in ground", "value": "stake" },
            { "label": "MagSafe mount", "value": "magsafe" },
            { "label": "Height range", "value": "height" },
            { "label": "Remote", "value": "remote" },
            { "label": "None", "value": "none" }
          ]
        },
        {
          "type": "text",
          "id": "stat",
          "label": "Stat",
          "info": "Optional short number that carries the claim, e.g. \"4.8 oz\"."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium materials"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Homepage",
      "name": "Credibility band"
    }
  ]
}
{% endschema %}
