{% comment %}
  Fourth of July Landing Page — GPOD GOLF
  Target theme: Copy of Modular (PaulDev), ID 153797918888 (UNPUBLISHED)
  Do NOT deploy to live theme without explicit user approval.
{% endcomment %}

{%- style -%}
  :root {
    --fd-gold:      #C9A84C;
    --fd-green:     #2D4A2F;
    --fd-black:     #000000;
    --fd-white:     #ffffff;
    --fd-off-white: #f9f8f6;
    --fd-grey:      #f0efed;
    --fd-text:      #1a1a1a;
    --fd-muted:     #666666;
    --fd-border:    #e8e6e2;
  }

  *, *::before, *::after { box-sizing: border-box; }
  .fd-page { font-family: 'Saira', sans-serif; color: var(--fd-text); overflow-x: hidden; }

  /* ─── Shared ─── */
  .fd-btn {
    display: inline-block;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 100px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.15s ease;
    text-align: center;
    white-space: nowrap;
  }
  .fd-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.18); }
  .fd-btn--gold        { background: var(--fd-gold);  color: var(--fd-black); border-color: var(--fd-gold); }
  .fd-btn--gold:hover  { background: #b8962e; border-color: #b8962e; box-shadow: 0 8px 28px rgba(201,168,76,0.4); }
  .fd-btn--black       { background: var(--fd-black); color: var(--fd-white); border-color: var(--fd-black); }
  .fd-btn--black:hover { background: #222; }
  .fd-btn--ghost       { background: transparent; color: var(--fd-white); border-color: rgba(255,255,255,0.4); }
  .fd-btn--ghost:hover { border-color: var(--fd-white); }
  .fd-btn--outline     { background: transparent; color: var(--fd-black); border-color: var(--fd-black); }
  .fd-btn--sm   { font-size: 12px; padding: 12px 22px; }
  .fd-btn--full { width: 100%; }

  .fd-eyebrow {
    font-family: 'Poppins', sans-serif;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--fd-gold); display: block; margin-bottom: 14px;
  }

  /* ─── Hero ─── */
  .fd-hero {
    background-color: var(--fd-black);
    color: var(--fd-white);
    min-height: 92vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .fd-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 80px 40px 80px 48px;
    position: relative;
    z-index: 1;
  }
  .fd-hero__headline {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: clamp(36px, 4.5vw, 72px);
    line-height: 1.03;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
    text-align: center;
    width: 100%;
  }
  .fd-hero__headline em { font-style: normal; color: var(--fd-gold); display: block; }
  .fd-hero__sub {
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.68;
    opacity: 0.78;
    max-width: 480px;
    margin-bottom: 44px;
    text-align: center;
  }
  .fd-hero__ctas { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .fd-hero__nudge {
    margin-top: 40px;
    font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; opacity: 0.35;
    text-align: center;
  }
  .fd-hero__visual {
    position: relative;
    overflow: hidden;
    min-height: 560px;
  }
  .fd-hero__img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  .fd-hero__visual-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--fd-black) 0%, transparent 30%);
  }
  .fd-hero__visual--placeholder {
    background: linear-gradient(135deg, #111 0%, #1a1a1a 100%);
    display: flex; align-items: center; justify-content: center;
  }
  .fd-hero__placeholder-text {
    font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: rgba(255,255,255,0.15); text-align: center;
  }

  /* ─── Single Photo Strip ─── */
  .fd-photo-hero {
    height: 480px;
    overflow: hidden;
    position: relative;
    background: #111;
  }
  .fd-photo-hero img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    transition: transform 0.8s ease;
  }
  .fd-photo-hero:hover img { transform: scale(1.02); }

  /* ─── Story ─── */
  .fd-story { background: var(--fd-white); padding: 104px 64px; }
  .fd-story__inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 96px; align-items: start;
  }
  .fd-story__chapter { margin-bottom: 56px; }
  .fd-story__chapter:last-child { margin-bottom: 0; }
  .fd-story__label {
    font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--fd-gold); display: block; margin-bottom: 16px;
  }
  .fd-story__pull {
    font-family: 'Poppins', sans-serif; font-weight: 800;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.2; letter-spacing: -0.02em;
    color: var(--fd-black); margin: 0 0 20px;
  }
  .fd-story__body { font-size: 17px; line-height: 1.82; color: #3a3a3a; }
  .fd-story__body p { margin: 0 0 18px; }
  .fd-story__body p:last-child { margin-bottom: 0; }
  .fd-story__quote {
    background: var(--fd-off-white);
    border-left: 3px solid var(--fd-gold);
    padding: 20px 24px; border-radius: 0 8px 8px 0; margin: 24px 0;
    font-family: 'Poppins', sans-serif; font-size: 17px; font-weight: 600;
    font-style: italic; color: var(--fd-black); line-height: 1.5;
  }
  .fd-story__rule {
    border: none; border-top: 1px solid var(--fd-border);
    margin: 52px 0; width: 60px;
  }
  .fd-story__right { position: sticky; top: 80px; }
  .fd-story__photo-stack { position: relative; }
  .fd-story__photo-main {
    width: 100%; aspect-ratio: 3 / 4;
    object-fit: cover; border-radius: 16px; display: block;
  }
  .fd-story__photo-tag {
    position: absolute; top: 20px; left: 20px;
    background: var(--fd-black); color: var(--fd-white);
    font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.15em; text-transform: uppercase;
    padding: 8px 16px; border-radius: 100px;
  }

  /* ─── Pivot ─── */
  .fd-pivot {
    background: var(--fd-black); color: var(--fd-white);
    padding: 104px 64px; text-align: center;
  }
  .fd-pivot__inner { max-width: 760px; margin: 0 auto; }
  .fd-pivot__headline {
    font-family: 'Poppins', sans-serif; font-weight: 800;
    font-size: clamp(28px, 3.5vw, 50px);
    line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 28px;
  }
  .fd-pivot__headline span { color: var(--fd-gold); }
  .fd-pivot__body { font-size: clamp(16px, 1.5vw, 19px); line-height: 1.75; color: rgba(255,255,255,0.72); }
  .fd-pivot__body p { margin: 0 0 18px; }
  .fd-pivot__body p:last-child { margin-bottom: 0; }
  .fd-pivot__cta { margin-top: 48px; }

  /* ─── Promo Banner ─── */
  .fd-promo-bar {
    background: var(--fd-black); color: var(--fd-white);
    padding: 40px 32px;
    border-top: 3px solid var(--fd-gold);
    border-bottom: 3px solid var(--fd-gold);
  }
  .fd-promo-bar__inner {
    max-width: 900px; margin: 0 auto;
    display: flex; flex-direction: column;
    align-items: center; gap: 20px; text-align: center;
  }
  .fd-promo-bar__deals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px; width: 100%;
  }
  .fd-promo-bar__deal {
    padding: 24px 20px;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    border: 1.5px solid rgba(201,168,76,0.35); border-radius: 16px;
  }
  .fd-promo-bar__deal-icon { font-size: 26px; line-height: 1; }
  .fd-promo-bar__deal-label {
    font-family: 'Poppins', sans-serif; font-size: 9px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--fd-gold);
  }
  .fd-promo-bar__deal-value {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(18px, 2vw, 26px); font-weight: 800;
    color: var(--fd-white); line-height: 1.1;
  }
  .fd-promo-bar__deal-value span { color: var(--fd-gold); }
  .fd-promo-bar__deal-sub {
    font-size: 12px; line-height: 1.45;
    color: rgba(255,255,255,0.6);
  }
  .fd-promo-bar__code-wrap {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center;
  }
  .fd-promo-bar__code-label {
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 600;
    color: rgba(255,255,255,0.7);
  }
  .fd-promo-bar__code {
    background: var(--fd-gold); color: var(--fd-black);
    font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 900;
    letter-spacing: 0.25em; padding: 10px 24px; border-radius: 100px;
  }
  .fd-promo-bar__fine {
    font-size: 11px; opacity: 0.4; font-family: 'Poppins', sans-serif;
  }

  /* ─── Bundles ─── */
  .fd-bundles { background: var(--fd-off-white); padding: 104px 64px; }
  .fd-bundles__header { text-align: center; max-width: 680px; margin: 0 auto 64px; }
  .fd-bundles__title {
    font-family: 'Poppins', sans-serif; font-weight: 800;
    font-size: clamp(28px, 3vw, 46px);
    line-height: 1.1; letter-spacing: -0.02em; color: var(--fd-black); margin: 0 0 16px;
  }
  .fd-bundles__sub { font-size: 17px; line-height: 1.65; color: var(--fd-muted); }

  .fd-bundles__grid {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 28px; align-items: start;
  }

  /* ─── Bundle Card ─── */
  .fd-bundle {
    background: var(--fd-white); border-radius: 24px; overflow: hidden;
    display: flex; flex-direction: column;
    border: 1.5px solid var(--fd-border);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    height: 100%;
  }
  .fd-bundle:hover { box-shadow: 0 20px 56px rgba(0,0,0,0.1); transform: translateY(-5px); }
  .fd-bundle--featured { border-color: var(--fd-gold); box-shadow: 0 8px 40px rgba(201,168,76,0.18); }
  .fd-bundle--featured:hover { box-shadow: 0 24px 64px rgba(201,168,76,0.25); }

  .fd-bundle__top {
    padding: 20px 20px 0;
    display: flex; align-items: center; justify-content: space-between;
    min-height: 40px;
  }
  .fd-bundle__tier {
    font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--fd-muted);
  }
  .fd-bundle__badge {
    background: var(--fd-gold); color: var(--fd-black);
    font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 100px;
  }

  .fd-bundle__img-wrap { padding: 20px; }
  .fd-bundle__img {
    width: 100%; aspect-ratio: 1 / 1;
    object-fit: contain; display: block;
    border-radius: 12px; background: var(--fd-off-white);
  }

  .fd-bundle__body { padding: 8px 24px 20px; flex: 1; display: flex; flex-direction: column; }
  .fd-bundle__title {
    font-family: 'Poppins', sans-serif; font-weight: 800;
    font-size: 19px; line-height: 1.2; color: var(--fd-black); margin: 0 0 4px;
  }
  .fd-bundle__includes { font-size: 13px; color: var(--fd-muted); font-weight: 500; margin-bottom: 14px; }
  .fd-bundle__price-row {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin-bottom: 14px;
  }
  .fd-bundle__price {
    font-family: 'Poppins', sans-serif; font-size: 32px;
    font-weight: 800; color: var(--fd-black); line-height: 1; margin: 0;
  }
  .fd-bundle__compare {
    font-family: 'Poppins', sans-serif; font-size: 18px;
    font-weight: 500; color: var(--fd-muted); text-decoration: line-through; line-height: 1;
  }
  .fd-bundle__savings {
    font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--fd-green); background: #e8f0e8; padding: 3px 10px; border-radius: 100px;
  }
  .fd-bundle__desc { font-size: 14px; line-height: 1.65; color: #555; margin-bottom: 18px; flex: 1; }
  .fd-bundle__bullets {
    list-style: none; padding: 0; margin: 0 0 0;
    display: flex; flex-direction: column; gap: 8px;
  }
  .fd-bundle__bullets li {
    display: flex; align-items: flex-start; gap: 8px;
    font-size: 13px; line-height: 1.45; color: #333;
  }
  .fd-check {
    flex-shrink: 0; width: 17px; height: 17px;
    background: var(--fd-green); color: var(--fd-white);
    border-radius: 50%; font-size: 9px; font-weight: 700;
    display: flex; align-items: center; justify-content: center; margin-top: 1px;
  }

  /* ─── Add-on info box ─── */
  .fd-addon {
    margin: 16px 20px 0;
    border: 1.5px solid rgba(201,168,76,0.4); border-radius: 16px; padding: 14px 16px;
    background: rgba(201,168,76,0.05);
  }
  .fd-addon__row { display: flex; align-items: center; gap: 10px; }
  .fd-addon__img {
    width: 48px; height: 48px; object-fit: contain; border-radius: 8px;
    background: var(--fd-off-white); flex-shrink: 0; padding: 4px;
  }
  .fd-addon__label {
    font-family: 'Poppins', sans-serif; font-size: 9px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--fd-gold); margin-bottom: 1px;
  }
  .fd-addon__name {
    font-family: 'Poppins', sans-serif; font-weight: 700;
    font-size: 13px; color: var(--fd-black); line-height: 1.2; margin-bottom: 3px;
  }
  .fd-addon__desc {
    font-size: 11px; line-height: 1.5; color: #666; margin-bottom: 6px;
  }
  .fd-addon__prices { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .fd-addon__sale {
    font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 15px; color: var(--fd-black);
  }
  .fd-addon__orig { font-size: 11px; color: var(--fd-muted); text-decoration: line-through; }
  .fd-addon__save {
    font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 700;
    color: var(--fd-green); background: rgba(45,74,47,0.1); padding: 2px 7px; border-radius: 100px;
  }
  .fd-addon__unlock {
    margin-top: 6px; font-size: 11px; font-weight: 600;
    color: var(--fd-gold); font-family: 'Poppins', sans-serif;
  }

  /* ─── Bundle CTAs ─── */
  .fd-bundle__ctas {
    padding: 16px 20px 0; display: flex; flex-direction: column; gap: 10px;
  }
  .fd-bundle__cta-primary {
    display: block; width: 100%;
    font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 13px;
    letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    padding: 16px 20px; border-radius: 100px; border: none; cursor: pointer;
    background: var(--fd-gold); color: var(--fd-black);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.15s ease;
    text-align: center;
  }
  .fd-bundle__cta-primary:hover { background: #b8962e; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(201,168,76,0.4); }
  .fd-bundle__cta-solo {
    background: none; border: none; cursor: pointer; width: 100%;
    font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 500;
    color: var(--fd-muted); text-decoration: underline; text-underline-offset: 3px;
    padding: 4px 0; text-align: center;
    transition: color 0.15s ease;
  }
  .fd-bundle__cta-solo:hover { color: var(--fd-black); }

  /* ─── Shipping note ─── */
  .fd-bundle__foot {
    padding: 12px 20px 20px;
    text-align: center; font-size: 12px; color: var(--fd-muted); line-height: 1.5;
  }
  .fd-code {
    font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 11px; letter-spacing: 0.16em;
    background: var(--fd-black); color: var(--fd-gold);
    padding: 3px 10px; border-radius: 100px; display: inline-block; margin-top: 4px;
  }

  /* ─── Travel Upsell Modal ─── */
  .fd-modal-overlay {
    display: none; position: fixed; inset: 0; z-index: 9999;
    background: rgba(0,0,0,0.65); backdrop-filter: blur(4px);
    align-items: center; justify-content: center; padding: 20px;
  }
  .fd-modal-overlay.is-open { display: flex; }
  .fd-modal {
    background: var(--fd-white); border-radius: 24px;
    max-width: 440px; width: 100%; padding: 36px 32px;
    position: relative; box-shadow: 0 32px 80px rgba(0,0,0,0.35);
    animation: fdModalIn 0.22s ease;
  }
  @keyframes fdModalIn {
    from { opacity: 0; transform: scale(0.93) translateY(12px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  .fd-modal__close {
    position: absolute; top: 16px; right: 20px;
    background: none; border: none; font-size: 22px; cursor: pointer;
    color: var(--fd-muted); line-height: 1; padding: 4px;
  }
  .fd-modal__close:hover { color: var(--fd-black); }
  .fd-modal__icon { font-size: 40px; margin-bottom: 12px; display: block; text-align: center; }
  .fd-modal__title {
    font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 22px;
    line-height: 1.2; color: var(--fd-black); margin: 0 0 10px; text-align: center;
  }
  .fd-modal__title em { font-style: normal; color: var(--fd-gold); }
  .fd-modal__body {
    font-size: 14px; line-height: 1.65; color: #555; text-align: center; margin-bottom: 20px;
  }
  .fd-modal__offer {
    background: var(--fd-off-white); border: 1.5px solid rgba(201,168,76,0.4);
    border-radius: 14px; padding: 14px 16px; margin-bottom: 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .fd-modal__offer-img {
    width: 56px; height: 56px; object-fit: contain; border-radius: 10px;
    background: var(--fd-white); flex-shrink: 0;
  }
  .fd-modal__offer-name {
    font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 14px;
    color: var(--fd-black); margin-bottom: 3px;
  }
  .fd-modal__offer-desc { font-size: 12px; color: #666; line-height: 1.4; margin-bottom: 5px; }
  .fd-modal__offer-prices { display: flex; align-items: baseline; gap: 6px; }
  .fd-modal__offer-sale { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 16px; }
  .fd-modal__offer-orig { font-size: 12px; color: var(--fd-muted); text-decoration: line-through; }
  .fd-modal__offer-badge {
    font-size: 10px; font-weight: 700; font-family: 'Poppins', sans-serif;
    background: #e8f0e8; color: var(--fd-green); padding: 2px 8px; border-radius: 100px;
  }
  .fd-modal__unlock {
    font-size: 12px; font-weight: 700; color: var(--fd-gold);
    font-family: 'Poppins', sans-serif; margin-top: 4px;
  }
  .fd-modal__cta-yes {
    display: block; width: 100%; padding: 15px 20px;
    background: var(--fd-gold); color: var(--fd-black); border: none;
    font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 13px;
    letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    border-radius: 100px; cursor: pointer; text-align: center; margin-bottom: 10px;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .fd-modal__cta-yes:hover { background: #b8962e; transform: translateY(-1px); }
  .fd-modal__cta-no {
    display: block; width: 100%; background: none; border: none; cursor: pointer;
    font-family: 'Poppins', sans-serif; font-size: 12px; color: var(--fd-muted);
    text-decoration: underline; text-underline-offset: 3px; text-align: center;
    padding: 4px 0; transition: color 0.15s ease;
  }
  .fd-modal__cta-no:hover { color: var(--fd-black); }

  /* ─── Closing ─── */
  .fd-closing {
    background: var(--fd-black); color: var(--fd-white);
    padding: 120px 64px; text-align: center;
  }
  .fd-closing__headline {
    font-family: 'Poppins', sans-serif; font-weight: 800;
    font-size: clamp(32px, 4.5vw, 60px);
    line-height: 1.07; letter-spacing: -0.025em;
    margin: 16px auto 20px; max-width: 720px;
  }
  .fd-closing__headline em { font-style: normal; color: var(--fd-gold); }
  .fd-closing__body {
    font-size: clamp(16px, 1.5vw, 18px); line-height: 1.72;
    opacity: 0.72; max-width: 500px; margin: 0 auto 48px;
  }
  .fd-closing__urgency {
    margin-top: 28px; font-size: 12px; letter-spacing: 0.08em;
    opacity: 0.4; text-transform: uppercase;
    font-family: 'Poppins', sans-serif; font-weight: 600;
