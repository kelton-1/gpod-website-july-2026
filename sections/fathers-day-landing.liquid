    .fd-bundles__grid { gap: 20px; }
    .fd-story, .fd-pivot, .fd-bundles, .fd-closing { padding-left: 40px; padding-right: 40px; }
    .fd-hero__copy { padding: 64px 40px; }
  }

  @media (max-width: 900px) {
    .fd-hero { grid-template-columns: 1fr; min-height: auto; }
    .fd-hero__visual { order: -1; height: 56vw; min-height: 280px; }
    .fd-hero__visual-overlay { background: linear-gradient(to bottom, var(--fd-black) 0%, transparent 40%); }
