      </div>
    </div>
    <a href="#" class="fd-modal__cta-yes" id="fd-modal-yes">Yes — Add GPOD Travel to My Bundle</a>
    <button class="fd-modal__cta-no" id="fd-modal-no">No thanks, just the bundle</button>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('fd-travel-modal');
  var yesBtn = document.getElementById('fd-modal-yes');
  var noBtn = document.getElementById('fd-modal-no');
  var closeBtn = document.getElementById('fd-modal-close');
  var soloUrl = '';
  var upsellUrl = '';

  function openModal(solo, upsell) {
    soloUrl = solo;
    upsellUrl = upsell;
    yesBtn.href = upsell;
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.fd-bundle__cta-solo').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      openModal(btn.dataset.cart, btn.dataset.upsell);
    });
  });

  noBtn.addEventListener('click', function() {
    closeModal();
    window.location.href = soloUrl;
  });

  closeBtn.addEventListener('click', closeModal);

  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });
})();
</script>

