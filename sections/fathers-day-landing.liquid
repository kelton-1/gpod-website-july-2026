    .fd-hero__sub { margin-left: auto; margin-right: auto; text-align: center; }
    .fd-hero__ctas { justify-content: center; }
    .fd-hero__nudge { text-align: center; }
    .fd-photo-hero { height: 50vw; min-height: 240px; }
    .fd-story { padding: 72px 28px; }
    .fd-story__inner { grid-template-columns: 1fr; gap: 48px; }
    .fd-story__right { position: static; }
    .fd-bundles { padding: 72px 28px; }
    .fd-bundles__grid { grid-template-columns: 1fr 1fr; }
    .fd-bundle-wrap:last-child { grid-column: 1 / -1; max-width: 520px; margin: 0 auto; width: 100%; }
    .fd-pivot { padding: 72px 28px; }
    .fd-closing { padding: 80px 28px; }
  }

  @media (max-width: 600px) {
    .fd-photo-hero { height: 60vw; }
    .fd-bundles__grid { grid-template-columns: 1fr; }
    .fd-bundle-wrap:last-child { grid-column: auto; max-width: 100%; }
    .fd-hero__ctas { flex-direction: column; align-items: center; }
    .fd-hero__ctas .fd-btn { width: 100%; max-width: 320px; }
    .fd-hero__headline { font-size: clamp(30px, 8vw, 46px); text-align: center; }
    .fd-promo-bar { padding: 24px 16px; }
    .fd-promo-bar__deal { padding: 16px 12px; }
    .fd-promo-bar__deal-value { font-size: 16px; }
    .fd-promo-bar__deal-sub { font-size: 11px; }
  }
{%- endstyle -%}

