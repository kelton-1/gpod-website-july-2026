{% comment %}
  Collection cross-navigation: pills for sibling collections plus
  "compare / quiz" helper links. The pill matching the current collection
  is highlighted automatically.

  Also hosts the compare tray: a "Compare" checkbox is added to every
  product card in the grid, and picks collect in a floating tray that
  deep-links into the compare table (?models=). Picks survive navigation
  between collections, so a shopper can gather a monopod and a tripod
  before comparing. Logic lives in assets/gpod.js (initCompareSelect).
{% endcomment %}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}

<div class="gpod-section container-wrap section-padding"
  data-section-type="collection-toolbar"
  style="{{ style }}"
>
  <div class="container">
    <nav class="gpod-toolbar" aria-label="Browse collections">
      {%- if section.blocks.size > 0 -%}
        <div class="gpod-toolbar__pills">
          {%- for block in section.blocks -%}
            {%- liquid
              assign target = block.settings.collection
              assign pill_url = target.url | default: block.settings.link
              assign pill_label = block.settings.label | default: target.title
              assign is_active = false
              if collection != blank and target != blank and collection.handle == target.handle
                assign is_active = true
              endif
            -%}
            {%- if pill_url != blank and pill_label != blank -%}
              <a
                class="gpod-toolbar__pill{% if is_active %} is-active{% endif %}"
                href="{{ pill_url }}"
                {% if is_active %}aria-current="page"{% endif %}
                {{ block.shopify_attributes }}
              >{{ pill_label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="gpod-toolbar__help">
        {%- if section.settings.compare_text != blank -%}
          <a href="{{ section.settings.compare_link | default: '/pages/compare-gpod-models' }}">{{ section.settings.compare_text | escape }}</a>
        {%- endif -%}
        {%- if section.settings.quiz_text != blank -%}
          <a href="{{ section.settings.quiz_link | default: '/pages/product-finder-quiz' }}">{{ section.settings.quiz_text | escape }}</a>
        {%- endif -%}
      </div>
    </nav>
  </div>

  {%- if section.settings.enable_compare_select -%}
    {%- assign compare_url = section.settings.compare_link | default: '/pages/compare-gpod-models' -%}
    <div
      class="gpod-cmp"
      data-gpod-compare-select
      data-max="{{ section.settings.compare_max }}"
      data-compare-url="{{ compare_url }}"
    >
      <div class="gpod-cmp__tray" data-cmp-tray hidden role="region" aria-label="{{ section.settings.tray_label | default: 'Compare' | escape }}">
        <div class="gpod-cmp__tray-inner">
          <p class="gpod-cmp__label" aria-live="polite">
            {{ section.settings.tray_label | escape }}
            <span class="gpod-cmp__count" data-cmp-count></span>
          </p>
          <ul class="gpod-cmp__items" data-cmp-items></ul>
          <div class="gpod-cmp__actions">
            <span class="gpod-cmp__hint" data-cmp-hint>{{ section.settings.tray_hint | escape }}</span>
            <a class="gpod-cmp__go btn btn--primary btn--solid" data-cmp-go href="{{ compare_url }}">
              {{- section.settings.tray_cta | escape -}}
            </a>
            <button type="button" class="gpod-cmp__clear" data-cmp-clear>{{ section.settings.tray_clear | escape }}</button>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collection toolbar",
  "class": "shopify-section--collection-toolbar",
  "settings": [
    {
      "type": "text",
      "id": "compare_text",
      "label": "Compare link label",
      "default": "Compare models"
    },
    {
      "type": "url",
      "id": "compare_link",
      "label": "Compare link"
    },
    {
      "type": "text",
      "id": "quiz_text",
      "label": "Quiz link label",
      "default": "Take the Quiz"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Quiz link"
    },
    {
      "type": "header",
      "content": "Compare tray"
    },
    {
      "type": "checkbox",
      "id": "enable_compare_select",
      "label": "Add compare checkboxes to product cards",
      "default": true,
      "info": "Shoppers tick up to three models, then jump to the compare table with only those models shown."
    },
    {
      "type": "range",
      "id": "compare_max",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Models a shopper can pick",
      "default": 3
    },
    {
      "type": "text",
      "id": "tray_label",
      "label": "Tray label",
      "default": "Comparing"
    },
    {
      "type": "text",
      "id": "tray_hint",
      "label": "Tray hint (shown with one pick)",
      "default": "Pick one more to compare"
    },
    {
      "type": "text",
      "id": "tray_cta",
      "label": "Tray button",
      "default": "Compare side by side"
    },
    {
      "type": "text",
      "id": "tray_clear",
      "label": "Tray clear label",
      "default": "Clear"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Collection pill",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (if no collection)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "category": "Collection",
      "name": "Collection toolbar",
      "blocks": [
        { "type": "pill" },
        { "type": "pill" },
        { "type": "pill" },
        { "type": "pill" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
