{% comment %}
  Native home hero: background video OR static image (separate mobile media),
  headline + subhead, trust row, and two CTAs (shop + quiz).
  Mobile-first; media is decorative (aria-hidden) with a dark overlay for
  text contrast.
{% endcomment %}

{%- liquid
  assign media_type = section.settings.media_type
  assign video = section.settings.video_bg
  assign video_mobile = section.settings.video_bg_mobile
  assign image = section.settings.image
  assign image_mobile = section.settings.mobile_image
  assign has_mobile_media = false
  if media_type == 'video' and video_mobile != blank
    assign has_mobile_media = true
  elsif media_type == 'image' and image_mobile != blank
    assign has_mobile_media = true
  endif
-%}

{%- capture style -%}
  --hero-h: {{ section.settings.height_desktop }}px;
  --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
{%- endcapture -%}

{%- comment -%}
  `gpod-section` is load-bearing, not decorative: the theme applies
  `outline: none` to focus globally, and the custom layer restores a visible
  focus ring scoped to `.gpod-section`. Without the class the two primary
  CTAs on the highest-traffic page in the store had no keyboard focus ring.
{%- endcomment -%}
<section class="gpod-section gpod-hero{% if section.settings.mobile_fullscreen %} gpod-hero--mobile-full{% endif %}"
  data-section-type="home-hero"
  data-gpod-play-video-mobile="{{ section.settings.play_video_mobile }}"
  style="{{ style }}"
>
  <div class="gpod-hero__media" aria-hidden="true">
    {%- if media_type == 'video' and video != blank -%}
      <div class="gpod-hero__layer{% if has_mobile_media %} gpod-hero__layer--desktop{% endif %}">
        {{ video | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '1600x' }}
      </div>
      {%- if has_mobile_media -%}
        <div class="gpod-hero__layer gpod-hero__layer--mobile">
          {{ video_mobile | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '900x' }}
        </div>
      {%- endif -%}
    {%- elsif media_type == 'image' and image != blank -%}
      <img
        class="gpod-hero__layer{% if has_mobile_media %} gpod-hero__layer--desktop{% endif %}"
        src="{{ image | image_url: width: 1600 }}"
        srcset="{{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        width="{{ image.width }}"
        height="{{ image.height }}"
        alt=""
        fetchpriority="high"
      >
      {%- if has_mobile_media -%}
        <img
          class="gpod-hero__layer gpod-hero__layer--mobile"
          src="{{ image_mobile | image_url: width: 800 }}"
          srcset="{{ image_mobile | image_url: width: 500 }} 500w, {{ image_mobile | image_url: width: 800 }} 800w, {{ image_mobile | image_url: width: 1100 }} 1100w"
          sizes="100vw"
          width="{{ image_mobile.width }}"
          height="{{ image_mobile.height }}"
          alt=""
          fetchpriority="high"
        >
      {%- endif -%}
    {%- endif -%}
    <div class="gpod-hero__overlay"></div>
  </div>

  <div class="gpod-hero__content container">
    {%- if section.settings.headline != blank -%}
      <h1 class="gpod-hero__headline">{{ section.settings.headline | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subhead != blank -%}
      <p class="gpod-hero__subhead">{{ section.settings.subhead | escape }}</p>
    {%- endif -%}

    {%- if section.settings.show_trust and section.settings.trust_text != blank -%}
      <p class="gpod-hero__trust">
        <span class="gpod-hero__trust-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="18" height="18" focusable="false"><path d="M10 1.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm-1.2 12.1L5.2 10l1.4-1.4 2.2 2.2 4.7-4.7 1.4 1.4-6.1 6.1Z" fill="currentColor"/></svg>
        </span>
        <span>{{ section.settings.trust_text | escape }}</span>
      </p>
    {%- endif -%}

    <div class="gpod-hero__ctas">
      {%- if section.settings.cta1_text != blank -%}
        <a class="btn btn--primary btn--solid btn--large" href="{{ section.settings.cta1_link | default: '/collections/frontpage' }}">{{ section.settings.cta1_text | escape }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_text != blank -%}
        <a class="btn btn--white btn--outline btn--large" href="{{ section.settings.cta2_link | default: '/pages/product-finder-quiz' }}">{{ section.settings.cta2_text | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<script src="{{ 'gpod.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Home hero",
  "class": "shopify-section--home-hero",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Background type",
      "default": "video",
      "options": [
        { "label": "Video", "value": "video" },
        { "label": "Image", "value": "image" }
      ]
    },
    {
      "type": "video",
      "id": "video_bg",
      "label": "Video (desktop)"
    },
    {
      "type": "video",
      "id": "video_bg_mobile",
      "label": "Video (mobile)",
      "info": "Optional vertical crop. Falls back to the desktop video."
    },
    {
      "type": "checkbox",
      "id": "play_video_mobile",
      "label": "Play background video on mobile",
      "info": "Leave off for faster paid-traffic entry. Mobile visitors see the Shopify-generated video poster instead.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image (mobile)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 480,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 660
    },
    {
      "type": "checkbox",
      "id": "mobile_fullscreen",
      "label": "Full-screen on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "WE MAKE FILMING YOUR SWING EASY."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subheading",
      "default": "Just stick it and swing it."
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust line",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust line",
      "default": "Trusted by 75,000+ Golfers"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta1_text",
      "label": "Primary button label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Secondary button label",
      "default": "Take the Quiz"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "category": "Hero",
      "name": "Home hero"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
