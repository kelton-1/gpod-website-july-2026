{% comment %}
  "Shop by how you practice" tiles — each block links a use-case collection
  with situational copy. Image falls back to the collection image.
{% endcomment %}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}

<section class="gpod-section gpod-usecases{% if section.settings.grid_style == 'compact' %} gpod-usecases--compact{% endif %} container-wrap section-padding{% if section.settings.center_heading %} gpod-section--center{% endif %}"
  data-section-type="home-use-cases"
  style="{{ style }}"
>
  <div class="container">
    {%- if section.settings.kicker != blank -%}
      <p class="gpod-kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="gpod-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="gpod-lede">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gpod-usecases__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign target = block.settings.collection
            assign tile_url = target.url | default: block.settings.link
            assign tile_title = block.settings.title | default: target.title
            assign tile_image = block.settings.image | default: target.image
          -%}
          {%- if tile_url != blank and tile_title != blank -%}
            <a class="gpod-usecase" href="{{ tile_url }}" {{ block.shopify_attributes }}>
              {%- if tile_image -%}
                <img
                  src="{{ tile_image | image_url: width: 480 }}"
                  srcset="{{ tile_image | image_url: width: 480 }} 480w, {{ tile_image | image_url: width: 720 }} 720w, {{ tile_image | image_url: width: 960 }} 960w"
                  sizes="(min-width: 1024px) 25vw, (min-width: 600px) 50vw, 100vw"
                  loading="lazy"
                  alt=""
                >
              {%- endif -%}
              <div class="gpod-usecase__content">
                <h3>{{ tile_title | escape }}</h3>
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Use-case tiles",
  "class": "shopify-section--home-use-cases",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shop by how you practice"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where do you play?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Center heading",
      "default": true
    },
    {
      "type": "select",
      "id": "grid_style",
      "label": "Tile style",
      "default": "feature",
      "options": [
        { "label": "Feature (tall)", "value": "feature" },
        { "label": "Compact", "value": "compact" }
      ]
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Use-case tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Situational line",
          "info": "e.g. 'Stake it into the turf between shots'"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (if no collection)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "category": "Collection",
      "name": "Use-case tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
