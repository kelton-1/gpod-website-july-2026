{%- liquid
  comment
    Layout
  endcomment
  assign content_alignment = section.settings.content_alignment

  comment
    Settings
  endcomment
  assign transition_text = settings.transition_text
  assign animation_delay = 0
  assign animation_anchor = '#split-hero--' | append: section.id

  comment
    Colors
  endcomment
  assign overlay_color = section.settings.overlay_color
  assign overlay_opacity = section.settings.overlay_opacity | times: 0.01 | round: 2
  assign color_style = section.settings.color_style

  comment
    Content
  endcomment
  assign heading = section.settings.title
  assign subheading = section.settings.subheading
  assign text = section.settings.text

  assign first_button_text = section.settings.cta
  assign first_button_link = section.settings.link
  assign first_button_size = section.settings.first_button_size
  assign first_button_style = section.settings.first_button_style
  assign first_button_type = section.settings.first_button_type

  assign second_button_text = section.settings.cta_2
  assign second_button_link = section.settings.link_2
  assign second_button_size = section.settings.second_button_size
  assign second_button_style = section.settings.second_button_style
  assign second_button_type = section.settings.second_button_type
-%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;

  {%- unless overlay_color == 'rgba(0,0,0,0)' or overlay_color == '' or overlay_opacity == 0 -%}
    --overlay-color: {{ overlay_color }};
    --overlay-opacity: {{ overlay_opacity }};
  {%- endunless -%}
{%- endcapture -%}

{%- capture image_overlay -%}
  <div class="split-hero__overlay"></div>
{%- endcapture -%}

<section id="split-hero--{{ section.id }}"
  class="section-padding"
  data-section-type="split-hero"
  data-section-id="{{ section.id }}"
  style="{{ style }}">
  <div class="split-hero {{ section.settings.image_height }} {{ section.settings.image_height }}--mobile" data-style="{{ color_style }}">
    <div class="split-hero__half split-hero__half--left">
      {%- assign image = section.settings.image_desktop_left -%}
      {%- assign image_mobile = section.settings.image_mobile_left -%}

      {%- render 'split-hero-image', image: image, image_mobile: image_mobile -%}
      {{- image_overlay -}}
    </div>
    <div class="split-hero__half split-hero__half--right">
      {%- assign image = section.settings.image_desktop_right -%}
      {%- assign image_mobile = section.settings.image_mobile_right -%}

      {%- render 'split-hero-image', image: image, image_mobile: image_mobile -%}
      {{- image_overlay -}}
    </div>

    <div class="split-hero__content split-hero__content--{{ content_alignment }}">
      <div class="container">
        <div class="row">
          <div class="split-hero__text">
            {%- if subheading != blank -%}
              <p
                class="split-hero__subheading subheading-text"
                {% if transition_text %}
                data-aos="fade-up"
                data-aos-delay="{{ animation_delay }}"
                data-aos-anchor="{{ animation_anchor }}"
                {% endif %}>
                {{- subheading -}}
              </p>
              {%- assign animation_delay = animation_delay | plus: 250 -%}
            {%- endif -%}

            {%- if heading != blank -%}
              <h2
                class="split-hero__heading size--heading-1"
                {% if transition_text %}
                data-aos="fade-up"
                data-aos-delay="{{ animation_delay }}"
                data-aos-anchor="{{ animation_anchor }}"
                {% endif %}>
                {{- heading -}}
              </h2>
              {%- assign animation_delay = animation_delay | plus: 250 -%}
            {%- endif -%}

            {%- if text != blank -%}
              <div
                class="split-hero__richtext"
                {% if transition_text %}
                data-aos="fade-up"
                data-aos-delay="{{ animation_delay }}"
                data-aos-anchor="{{ animation_anchor }}"
                {% endif %}>
                {{- text -}}
              </div>
              {%- assign animation_delay = animation_delay | plus: 250 -%}
            {%- endif -%}

            {%- if first_button_text != blank or second_button_text != blank -%}
              <div class="split-hero__buttons{% if first_button_text != blank and second_button_text != blank %} split-hero__buttons--inline{% endif %}"{% if transition_text %}data-aos="fade-up"data-aos-delay="{{ animation_delay }}"data-aos-anchor="{{ animation_anchor }}"{% endif %}>
                {%- if first_button_text != blank -%}
                  <a
                    tabindex="0"
                    href="{{ first_button_link | default: '#!' }}"
                    class="split-hero__button btn {{ first_button_size }} {{ first_button_style }} {{ first_button_type }}"
                    aria-label="{{ first_button_text }}"
                    title="{{ first_button_text }}">{{ first_button_text }}</a>
                {%- endif -%}

                {%- if second_button_text != blank -%}
                  <a
                    tabindex="0"
                    href="{{ second_button_link | default: '#!' }}"
                    class="split-hero__button btn {{ second_button_size }} {{ second_button_style }} {{ second_button_type }}"
                    aria-label="{{ second_button_text }}"
                    title="{{ second_button_text }}">{{ second_button_text }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% comment %} Schema {% endcomment %}
