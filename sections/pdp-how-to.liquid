{% comment %}
  PDP: how to set up and use — video (per-product gpod.setup_video_url metafield
  overrides the section setting) + numbered steps. Directly answers the top
  support complaints: twist-lock extension use and remote pairing.
{% endcomment %}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}

{%- liquid
  assign video_url = product.metafields.gpod.setup_video_url.value | default: section.settings.video_url
  assign video_id = ''
  assign video_type = ''
  if video_url contains 'youtube.com/watch?v='
    assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first
    assign video_type = 'youtube'
  elsif video_url contains 'youtu.be/'
    assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
    assign video_type = 'youtube'
  elsif video_url contains 'vimeo.com/'
    assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first
    assign video_type = 'vimeo'
  endif

  assign applicable_collection = section.settings.applicable_collection
  assign product_collection_handles = product.collections | map: 'handle'
  assign is_applicable = false
  assign has_content = false
  assign visible_steps = 0

  if applicable_collection == blank or product_collection_handles contains applicable_collection.handle
    assign is_applicable = true
  endif

  for block in section.blocks
    if block.settings.title != blank or block.settings.text != blank
      assign visible_steps = visible_steps | plus: 1
    endif
  endfor

  if video_type != blank or visible_steps > 0
    assign has_content = true
  endif
-%}

{%- if is_applicable and has_content -%}
<section class="gpod-section gpod-howto container-wrap section-padding"
  id="how-to"
  data-section-type="pdp-how-to"
  style="{{ style }}"
>
  <div class="container">
    {%- if section.settings.kicker != blank -%}
      <p class="gpod-kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="gpod-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- comment -%}
      No video means no second column. Without the modifier the grid keeps its
      1.1fr / 0.9fr split and the steps sit in the left half with 45% of the
      section empty — which is how it rendered on every product, because no
      product has gpod.setup_video_url set yet.
    {%- endcomment -%}
    <div class="gpod-howto__grid{% if video_type == blank %} gpod-howto__grid--no-video{% endif %}">
      {%- if video_type != blank -%}
        <div class="gpod-howto__video">
          {%- if video_type == 'youtube' -%}
            <iframe
              src="https://www.youtube-nocookie.com/embed/{{ video_id }}?rel=0"
              title="{{ section.settings.heading | default: 'Setup video' | escape }}"
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ video_id }}?dnt=1"
              title="{{ section.settings.heading | default: 'Setup video' | escape }}"
              loading="lazy"
              allow="fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if visible_steps > 0 -%}
        <div>
          <ol class="gpod-steps">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h3>{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
          {%- if section.settings.support_link_text != blank -%}
            <a class="btn btn--secondary btn--outline btn--small" href="{{ section.settings.support_link | default: '/pages/support' }}">
              {{- section.settings.support_link_text | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "PDP how-to",
  "class": "shopify-section--pdp-how-to",
  "settings": [
    {
      "type": "collection",
      "id": "applicable_collection",
      "label": "Limit to collection",
      "info": "Optional. The section stays hidden on products outside this collection."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to use it"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Fallback video URL (YouTube or Vimeo)",
      "info": "Per-product videos come from the product's 'Setup video URL' metafield; this is used when that's empty."
    },
    {
      "type": "url",
      "id": "support_link",
      "label": "Support link"
    },
    {
      "type": "text",
      "id": "support_link_text",
      "label": "Support link label",
      "default": "Guides & troubleshooting"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "category": "Product",
      "name": "PDP how-to",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
