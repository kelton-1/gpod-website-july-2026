{%- assign heading_tag = section.settings.heading_tag | default: 'h1' -%}

<div{% if section.settings.compact_mobile %} class="gpod-collection-hero--compact-mobile"{% endif %}>
  {%- render 'banner',
    image: section.settings.banner_image,
    mobile_image: section.settings.banner_image_mobile,
    desktop_height: section.settings.height,
    mobile_height: section.settings.height_mobile,
    transparent_header: true,
    text_position: section.settings.text_position,
    image_position: section.settings.image_position,
    color_text: section.settings.color_text,
    color_overlay: section.settings.color_overlay,
    overlay_opacity: section.settings.overlay_opacity,
    heading_tag: heading_tag,
    unique: section.id,
    blocks: section.blocks
  -%}
</div>

{% schema %}
{
  "name": "Image with text overlay",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "one-hundred-height-hero",
          "label": "Full screen"
        },
        {
          "value": "image-height",
          "label": "Image height"
        },
        {
          "value": "seven-fifty-height-hero",
          "label": "750px"
        },
        {
          "value": "sixty-fifty-height-hero",
          "label": "650px"
        },
        {
          "value": "five-fifty-height-hero",
          "label": "550px"
        },
        {
          "value": "four-fifty-height-hero",
          "label": "450px"
        }
      ],
      "default": "five-fifty-height-hero"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Height",
      "default": "one-hundred-height-hero--mobile",
      "options": [
        {
          "value": "one-hundred-height-hero--mobile",
          "label": "Full screen"
        },
        {
          "value": "image-height--mobile",
          "label": "Image height"
        },
        {
          "value": "seven-fifty-height-hero--mobile",
          "label": "750px"
        },
        {
          "value": "sixty-fifty-height-hero--mobile",
          "label": "650px"
        },
        {
          "value": "five-fifty-height-hero--mobile",
          "label": "550px"
        },
        {
          "value": "four-fifty-height-hero--mobile",
          "label": "450px"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "compact_mobile",
      "label": "Use compact mobile banner",
      "info": "Keeps the following content closer to the first screen on phones.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 only when this banner is the page's primary heading.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "default": "center",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Center", "value": "center" },
        { "label": "Right", "value": "right" },
        { "label": "Bottom left", "value": "bottom-left" },
        { "label": "Bottom right", "value": "bottom-right" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_overlay",
      "label": "Overlay",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "step": 5,
      "max": 95,
      "min": 0,
      "unit": "%",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Introducing"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Text block"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "btn_type",
          "label": "Color",
          "default": "btn--primary",
          "options": [
            { "label": "Primary", "value": "btn--primary" },
            { "label": "Secondary", "value": "btn--secondary" },
            { "label": "White", "value": "btn--white" },
            { "label": "Black", "value": "btn--black" }
          ]
        },
        {
          "type": "select",
          "id": "btn_size",
          "label": "Size",
          "default": "",
          "options": [
            { "label": "Small", "value": "btn--small" },
            { "label": "Medium", "value": "" },
            { "label": "Large", "value": "btn--large" }
          ]
        },
        {
          "type": "select",
          "id": "btn_style",
          "label": "Style",
          "default": "btn--solid",
          "options": [
            { "label": "Solid", "value": "btn--solid" },
            { "label": "Outline", "value": "btn--outline" },
            { "label": "Text", "value": "btn--text" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Image",
      "name": "Image with text overlay",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
