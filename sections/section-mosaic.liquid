{%- comment -%} Settings {%- endcomment -%}

{%- liquid
  assign mosaic_blocks_layout = section.settings.blocks_layout
  assign mosaic_blocks_height = section.settings.blocks_height
  assign text_color = section.settings.text_color
  assign mosaic_blocks_size = 0
  assign mosaic_has_text = false
  assign mosaic_hide_image_mobile = section.settings.hide_image_mobile
  assign image_position = section.settings.image_position
  assign image_blocks_count = 0
  assign transition_text = settings.transition_text
  assign transition_grid_items = settings.transition_grid_items
  assign animation_delay = 250
  assign overlay_color = section.settings.overlay_color
  assign overlay_opacity = section.settings.overlay_opacity | times: 0.01 | round: 2
  assign animation_anchor = '#section-mosaic--' | append: section.id

  if section.blocks.size < 3
    assign sizes = '(min-width: 1024px) calc((100vw - 20px) / 2 - 5px), calc(100vw - 20px)'
  else
    assign sizes = '(min-width: 1024px) calc((100vw - 20px) / 4 - 5px), calc(100vw - 20px)'
  endif

  assign widths = '195, 205, 245, 275, 400, 500, 565, 750, 800, 1000, 1130, 1500, 1600, 2000, 2260, 3000, 3200, 4000'
-%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;

  {%- unless overlay_color == 'rgba(0,0,0,0)' or overlay_color == '' or overlay_opacity == 0 -%}
    --overlay-color: {{ overlay_color }};
    --overlay-opacity: {{ overlay_opacity }};
  {%- endunless -%}
{%- endcapture -%}

{%- unless section.blocks.size == 0 -%}
  {%- capture mosaic_blocks_content -%}
    {%- assign index = 0 -%}
    {%- for block in section.blocks -%}
      {%- assign overlay_color = block.settings.overlay_color -%}
      {%- assign overlay_opacity = block.settings.overlay_opacity | times: 0.01 | round: 2 -%}

      {%- capture block_style -%}
        {%- unless overlay_color == 'rgba(0,0,0,0)' or overlay_color == '' or overlay_opacity == 0 -%}
          --overlay-color: {{ overlay_color }};
          --overlay-opacity: {{ overlay_opacity }};
        {%- endunless -%}
      {%- endcapture -%}

      {%- case block.type -%}
        {%- when 'image' -%}
          {%- liquid
            assign image = block.settings.image
            assign mosaic_blocks_size = mosaic_blocks_size | plus: 1
            assign image_blocks_count = image_blocks_count | plus: 1
            assign btn_label = block.settings.button_label
            assign btn_link = block.settings.button_link | default: '#'
            assign btn_style = block.settings.btn_style
            assign btn_type = block.settings.btn_type
            assign btn_size = block.settings.btn_size
          -%}

          {%- if btn_label == blank and btn_link != blank -%}
            <a class="mosaic__block mosaic__block--{{ block.id }} mosaic__block--image" href="{{ btn_link }}" data-slide="{{ block.id }}" data-slide-index="{{ index }}" {{ block.shopify_attributes }} style="{{ block_style }}">
          {%- else -%}
            <div class="mosaic__block mosaic__block--{{ block.id }} mosaic__block--image" data-slide="{{ block.id }}" data-slide-index="{{ index }}" {{ block.shopify_attributes }} style="{{ block_style }}">
          {%- endif -%}

              <div class="mosaic__block__inner"
                {% if transition_grid_items %}
                  data-aos="zoom-in-up"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-order="{{ index | plus: 1 }}"
                {% endif %}
              >
                {%- unless image == blank -%}
                  {%- render 'image' image: image, widths: widths, sizes: sizes, modifier: 'mosaic__block-bg' -%}
                {%- else -%}
                  <div class="mosaic__block-bg mosaic__block-bg--no-image">
                    <div class="svg-placeholder">
                      {{- 'image' | placeholder_svg_tag -}}
                    </div>
                  </div>
                {%- endunless -%}

                {%- unless btn_label == blank -%}
                  <div class="mosaic__block-text">
                    <div class="mosaic__button"
                      {% if transition_text %}
                        data-aos="fade-up"
                        data-aos-delay="{{ animation_delay }}"
                        data-aos-anchor="{{ animation_anchor }}"
                      {% endif %}
                    >
                      <a href="{{ btn_link }}" class="btn {{ btn_style }} {{ btn_type }} {{ btn_size }}">{{ btn_label }}</a>
                    </div>
                  </div>
                  {%- assign animation_delay = animation_delay | plus: 250 -%}
                {%- endunless -%}
              </div>

          {%- if btn_label == blank and btn_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}

        {%- when 'video' -%}
          {%- liquid
            assign mosaic_blocks_size = mosaic_blocks_size | plus: 1
            assign image_blocks_count = image_blocks_count | plus: 1
            assign image = block.settings.image
            assign link = block.settings.link
          -%}

          {%- capture video_link_markup -%}
            {%- unless link == blank -%}
              {%- if link.type == 'youtube' -%}
                {%- capture video_link -%}https://www.youtube.com/watch?v={{ link.id }}{%- endcapture -%}
              {%- elsif link.type == 'vimeo' -%}
                {%- capture video_link -%}https://vimeo.com/{{ link.id }}{%- endcapture -%}
              {%- endif -%}

              {%- assign video_parent_id = 'item-video-' | append: block.id -%}
              <a href="{{ video_link }}" class="mosaic__block-link mosaic__block-link--video" data-video-play="{% render 'photoswipe-video-html' item_link: link, item_id: video_parent_id %}" aria-label="{{ 'general.accessibility.play_video' | t }}">
                {%- render 'icon-play' -%}
              </a>
            {%- endunless -%}
          {%- endcapture -%}

          <div class="mosaic__block mosaic__block--{{ block.id }} mosaic__block--image mosaic__block--video" data-slide="{{ block.id }}" data-slide-index="{{ index }}" {{ block.shopify_attributes }} style="{{ block_style }}">
            <div class="mosaic__block__inner"{% if transition_grid_items %} data-aos="zoom-in-up" data-aos-anchor="{{ animation_anchor }}" data-aos-order="{{ index | plus: 1 }}"{% endif %}>
              {%- unless image == blank -%}
                {%- render 'image' image: image, widths: widths, sizes: sizes, modifier: 'mosaic__block-bg' -%}
              {%- else -%}
                <div class="mosaic__block-bg mosaic__block-bg--no-image">
                  <div class="svg-placeholder">
                    {{- 'image' | placeholder_svg_tag -}}
                  </div>
                </div>
              {%- endunless -%}

              {{- video_link_markup -}}
            </div>
          </div>

        {%- when 'product' -%}
          {%- liquid
            assign mosaic_blocks_size = mosaic_blocks_size | plus: 1
            assign image_blocks_count = image_blocks_count | plus: 1
            assign product_handle = block.settings.product
            assign product = all_products[product_handle]

            capture product_price
              if product.price == 0
                echo 'products.labels.free' | t
              elsif settings.currency_code_enable
                echo product.price | money_with_currency
              else
                echo product.price | money
              endif
            endcapture
          -%}

          <div class="mosaic__block mosaic__block--{{ block.id }} mosaic__block--product" data-slide="{{ block.id }}" data-slide-index="{{ index }}" {{ block.shopify_attributes }} style="{{ block_style }}">
            <div class="mosaic__block__inner" {% if transition_grid_items %} data-aos="zoom-in-up" data-aos-anchor="{{ animation_anchor }}" data-aos-order="{{ index | plus: 1 }}"{% endif %}>
              {%- unless product.empty? -%}
                {%- capture product_text -%}
                  <div class="mosaic__block-text">
                    <div class="mosaic__block-text-title">
                      <span class="mosaic__product__title">{{ product.title | strip_html }}</span>
                      <small class="mosaic__product__price">{{ product_price }}</small>
                    </div>
                  </div>
                {%- endcapture -%}

                {%- assign image = product.featured_media.preview_image -%}
                {%- unless image == blank -%}
                  <a href="{{ product.url }}" title="{{ product.title | strip_html }}" class="mosaic__block-link">
                    {%- render 'image' image: image, widths: widths, sizes: sizes, modifier: 'mosaic__block-bg', inner_html: product_text -%}
                  </a>
                {%- else -%}
                  <a href="{{ product.url }}" title="{{ product.title | strip_html }}" class="mosaic__block-bg mosaic__block-bg--no-image">
                    <div class="svg-placeholder">
                      {{- 'product-1' | placeholder_svg_tag -}}
                    </div>
                    {{- product_text -}}
                  </a>
                {%- endunless -%}
              {%- else -%}
                {%- liquid
                  capture onboarding_price
                    if settings.currency_code_enable
                      echo '9900' | money_with_currency
                    else
                      echo '9900' | money
                    endif
                  endcapture
                -%}
                <div class="mosaic__block-bg mosaic__block-bg--no-image">
                  <div class="svg-placeholder">
                    {{- 'product-1' | placeholder_svg_tag -}}
                  </div>
                  <div class="mosaic__block-text">
                    <div class="mosaic__block-text-title">
                      <span class="mosaic__product__title">{{- 'onboarding.product_title' | t -}}</span>
                      <small class="mosaic__product__price">{{ onboarding_price }}</small>
                    </div>
                  </div>
                </div>
              {%- endunless -%}
            </div>
          </div>

        {%- when 'collection' -%}
          {%- liquid
            assign mosaic_blocks_size = mosaic_blocks_size | plus: 1
            assign image_blocks_count = image_blocks_count | plus: 1
            assign collection_handle = block.settings.collection
            assign collection = collections[collection_handle]
            assign image = block.settings.image
          -%}

          <div class="mosaic__block mosaic__block--{{ block.id }} mosaic__block--collection" data-slide="{{ block.id }}" data-slide-index="{{ index }}" {{ block.shopify_attributes }} style="{{ block_style }}">
            <div class="mosaic__block__inner" {% if transition_grid_items %} data-aos="zoom-in-up" data-aos-anchor="{{ animation_anchor }}" data-aos-order="{{ index | plus: 1 }}"{% endif %} >
              {%- unless collection.empty? -%}
                {%- capture collection_title -%}
                  <div class="mosaic__block-text">
                    <div class="mosaic__block-text-title">{{ collection.title }}</div>
                  </div>
                {%- endcapture-%}

                {%- if image == blank -%}
                  {%- assign image = collection.image | default: collection.products.first.featured_media.preview_image -%}
                {%- endif -%}

                {%- unless image == blank -%}
                  <a href="{{ collection.url }}" title="{{ collection.title }}" class="mosaic__block-link">
                    {%- render 'image' image: image, widths: widths, sizes: sizes, modifier: 'mosaic__block-bg', inner_html: collection_title -%}
                  </a>
                {%- else -%}
                  <a href="{{ collection.url }}" title="{{ collection.title }}" class="mosaic__block-bg mosaic__block-bg--no-image">
                    <div class="svg-placeholder">
                      {{- 'collection-1' | placeholder_svg_tag -}}
                    </div>
                    {{- collection_title -}}
                  </a>
                {%- endunless -%}
              {%- else -%}
                {%- capture collection_title -%}
                  <div class="mosaic__block-text">
                    <div class="mosaic__block-text-title">{{ 'onboarding.collection' | t }}</div>
                  </div>
                {%- endcapture-%}

                {%- unless image == blank -%}
                  {%- render 'image' image: image, widths: widths, sizes: sizes, modifier: 'mosaic__block-bg', inner_html: collection_title -%}
                {%- else -%}
                  <div class="mosaic__block-bg mosaic__block-bg--no-image">
                    <div class="svg-placeholder">
                      {{- 'collection-1' | placeholder_svg_tag -}}
                    </div>
                    {{- collection_title -}}
                  </div>
                {%- endunless -%}
              {%- endunless -%}
            </div>
          </div>
      {%- endcase -%}

      {%- unless block.type == 'text' -%}
        {%- assign index = index | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endunless -%}

{%- liquid
  assign blocks_count = 'no-blocks'
  if mosaic_blocks_size == 1
    assign blocks_count = 'one'
  elsif mosaic_blocks_size == 2
    assign blocks_count = 'two'
  elsif mosaic_blocks_size == 3
    assign blocks_count = 'three'
  elsif mosaic_blocks_size == 4
    assign blocks_count = 'four'
  elsif mosaic_blocks_size == 5
    assign blocks_count = 'five'
  endif
-%}

{%- capture mosaic_blocks -%}
  {%- unless mosaic_blocks_content == blank -%}
    <div class="mosaic__blocks mosaic__blocks--{{ mosaic_blocks_layout }}">
      <div class="mosaic__blocks-inner" data-mosaic-blocks>
        {{- mosaic_blocks_content -}}
      </div>
      {%- unless mosaic_blocks_size == 1 -%}
        <button class="slider-arrow slider-arrow--prev slider-arrow--mosaic" aria-label="{{ 'slideshow.previous' | t }}" type="button" data-prev-arrow>{% render 'icon-submit' %}</button>
        <button class="slider-arrow slider-arrow--next slider-arrow--mosaic" aria-label="{{ 'slideshow.next' | t }}" type="button" data-next-arrow>{% render 'icon-submit' %}</button>
      {%- endunless -%}
    </div>
  {%- endunless -%}
{%- endcapture -%}

{%- unless section.blocks.size == 0 -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'text' -%}
        {%- capture mosaic_text -%}
          {%- liquid
            assign heading = block.settings.title
            assign subheading = block.settings.subheading
            assign text = block.settings.text
            assign btn_label = block.settings.button_label
            assign btn_size = block.settings.btn_size
            assign btn_style = block.settings.btn_style
            assign btn_type = block.settings.btn_type
          -%}

          {%- unless heading == blank and subheading == blank and text == blank and btn_label == blank -%}
            {%- assign mosaic_has_text = true -%}
            <div class="mosaic__content" data-block="mosaic" {{ block.shopify_attributes }}>
              <div class="mosaic__content-container">
                {%- unless subheading == blank -%}
                  <p class="mosaic__subheading subheading-text"{% if transition_text %} data-aos="fade-up" data-aos-delay="{{ animation_delay }}" data-aos-anchor="{{ animation_anchor }}"{% endif %}>
                    {{- subheading -}}
                  </p>
                  {%- assign animation_delay = animation_delay | plus: 250 -%}
                {%- endunless -%}

                {%- unless heading == blank -%}
                  <h2 class="mosaic__heading"{% if transition_text %} data-aos="fade-up" data-aos-delay="{{ animation_delay }}" data-aos-anchor="{{ animation_anchor }}"{% endif %}>
                    {{- heading -}}
                  </h2>
                  {%- assign animation_delay = animation_delay | plus: 250 -%}
                {%- endunless -%}

                {%- unless text == blank -%}
                  <p class="mosaic__text"{% if transition_text %} data-aos="fade-up" data-aos-delay="{{ animation_delay }}" data-aos-anchor="{{ animation_anchor }}"{% endif %}>
                    {{- text | truncate: 120 -}}
                  </p>
                  {%- assign animation_delay = animation_delay | plus: 250 -%}
                {%- endunless -%}

                {%- unless btn_label == blank -%}
                  {%- assign btn_link = block.settings.button_link | default: '#' -%}
                  <div class="mosaic__button"
                    {% if transition_text %}
                      data-aos="fade-up"
                      data-aos-delay="{{ animation_delay }}"
                      data-aos-anchor="{{ animation_anchor }}"
                    {% endif %}
                  >
                    <a href="{{ btn_link }}" class="btn {{ btn_size }} {{ btn_style }} {{ btn_type }}">{{ btn_label }}</a>
                  </div>
                  {%- assign animation_delay = animation_delay | plus: 250 -%}
                {%- endunless -%}
              </div>
            </div>
          {%- endunless -%}
        {%- endcapture -%}

    {%- endcase -%}
  {%- endfor -%}
{%- endunless -%}

{%- capture mosaic_banner -%}
  {%- liquid
    assign image = section.settings.image
    assign image_text = section.settings.image_text
    assign btn_label = section.settings.button_label
    assign btn_link = section.settings.button_link | default: '#'
    assign btn_style = section.settings.btn_style
    assign btn_type = section.settings.btn_type
    assign btn_size = section.settings.btn_size
  -%}

  {%- capture image_attributes -%}
    class="mosaic__image mosaic__image--{{ blocks_count }} mosaic__image--{{ image_position }}"
    {% if transition_grid_items %}
      data-aos="zoom-in-up"
      data-aos-anchor="{{ animation_anchor }}"
    {% endif %}
  {%- endcapture -%}

  {%- if btn_label == blank and btn_link != blank -%}
    <a href="{{ btn_link }}" {{ image_attributes }}>
  {%- else -%}
    <div {{ image_attributes }}>
  {%- endif -%}

    {%- unless image == blank -%}
      {%- assign sizes = '(min-width: 1024px) calc((100vw - 20px) / 2 - 5px), calc(100vw - 20px)' -%}
      {%- render 'image' image: image, widths: widths, sizes: sizes, modifier: 'mosaic__block-bg' -%}
    {%- else -%}
      <div class="mosaic__image-bg mosaic__image-bg--no-image">
        <div class="svg-placeholder">
          {{- 'image' | placeholder_svg_tag -}}
        </div>
      </div>
    {%- endunless -%}

    {%- unless image_text == blank and btn_label == blank -%}
      <div class="mosaic__image-text">
        {%- unless image_text == blank -%}
          <div>
            {{- image_text -}}
          </div>
        {%- endunless -%}

        {%- unless btn_label == blank -%}
          <div class="mosaic__button">
            <a href="{{ btn_link }}" class="btn {{ btn_style }} {{ btn_type }} {{ btn_size }}">{{ btn_label }}</a>
          </div>
        {%- endunless -%}
      </div>
    {%- endunless -%}

  {%- if btn_label == blank and btn_link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<section id="section-mosaic--{{ section.id }}"
  class="section-mosaic section-padding"
  data-section-type="mosaic"
  data-section-id="{{ section.id }}"
  data-text-color="{{ text_color }}"
  style="{{ style }}"
>
  <div class="mosaic__wrapper">
    <div class="mosaic__inner{% if image_position == 'right' %} mosaic__inner--reversed{% endif %}">
      <div class="mosaic-block mosaic-block--{{ mosaic_blocks_height }}{% if section.blocks.size == 0 %} mosaic__block--full-width{% endif %}{% if mosaic_hide_image_mobile %} med_hide{% endif %}">
        {{- mosaic_banner -}}
      </div>

      {%- unless section.blocks.size == 0 -%}
        <div class="mosaic-block{% if mosaic_has_text == false %} mosaic-block--no-text{% endif %}{% if image_blocks_count >= 4 %} mosaic-block--images-only{% endif %} mosaic-block--left mosaic-block--{{ mosaic_blocks_height }}">
          <div class="mosaic__blocks-wrapper mosaic__blocks--{{ blocks_count }}">
            {{- mosaic_text -}}
            {{- mosaic_blocks -}}
          </div>
        </div>
      {%- endunless -%}
    </div>
  </div>
</section>

{% comment %} Schema {% endcomment %}
{% schema %}
  {
    "name": "Mosaic",
    "class": "shopify-section--mosaic",
    "max_blocks": 5,
    "settings": [
      {
        "type": "header",
        "content": "Fixed image"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "Position",
        "default": "right",
        "options": [
          { "label": "Left", "value": "left" },
          { "label": "Right", "value": "right" }
        ]
      },
      {
        "type": "checkbox",
        "id": "hide_image_mobile",
        "label": "Hide on mobile",
        "default": false
      },
      {
        "type": "header",
        "content": "Overlay"
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Color",
        "default": "#333333"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Opacity",
        "min": 0,
        "max": 95,
        "step": 5,
        "unit": "%",
        "default": 0
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "image_text",
        "label": "Text"
      },
      {
        "type": "header",
        "content": "Button"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Label",
        "default": "Shop now",
        "info": "Leave blank to link entire image"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Link"
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Color",
        "default": "btn--primary",
        "options": [
          { "label": "Primary", "value": "btn--primary" },
          { "label": "Secondary", "value": "btn--secondary" },
          { "label": "White", "value": "btn--white" },
          { "label": "Black", "value": "btn--black" }
        ]
      },
      {
        "type": "select",
        "id": "btn_size",
        "label": "Size",
        "default": "",
        "options": [
          { "label": "Small", "value": "btn--small" },
          { "label": "Medium", "value": "" },
          { "label": "Large", "value": "btn--large" }
        ]
      },
      {
        "type": "select",
        "id": "btn_style",
        "label": "Style",
        "default": "btn--solid",
        "options": [
          { "label": "Solid", "value": "btn--solid" },
          { "label": "Outline", "value": "btn--outline" },
          { "label": "Text", "value": "btn--text" }
        ]
      },
      {
        "type": "header",
        "content": "Blocks layout"
      },
      {
        "type": "select",
        "id": "blocks_height",
        "label": "Height",
        "default": "default-height",
        "options": [
          { "label": "Full height", "value": "full-height" },
          { "label": "3/4 height", "value": "default-height" }
        ]
      },
      {
        "type": "select",
        "id": "blocks_layout",
        "label": "Layout",
        "default": "offset",
        "options": [
          { "label": "Split", "value": "split" },
          { "label": "Offset", "value": "offset" }
        ],
        "info": "Works when all 5/5 blocks are added and there is no product block included"
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "select",
        "id": "text_color",
        "label": "Overlay text and arrows",
        "default": "white",
        "options": [
          { "label": "White", "value": "white" },
          { "label": "Black", "value": "black" }
        ]
      },
      {
        "type": "header",
        "content": "Section padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding top",
        "default": 10
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding bottom",
        "default": 10
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Text",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Heading",
            "default": "Modular"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Subheading",
            "default": "Best Seller"
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Showcase a two of your best products, video, a collection, or text with the blocks in this section."
          },
          {
            "type": "header",
            "content": "Button"
          },
          {
            "type": "text",
            "id": "button_label",
            "label": "Label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Link"
          },
          {
            "type": "select",
            "id": "btn_type",
            "label": "Color",
            "default": "btn--primary",
            "options": [
              { "label": "Primary", "value": "btn--primary" },
              { "label": "Secondary", "value": "btn--secondary" },
              { "label": "White", "value": "btn--white" },
              { "label": "Black", "value": "btn--black" }
            ]
          },
