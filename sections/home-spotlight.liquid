{%- comment -%}
  Product spotlight card — Tenscope Round 2 (mobile frame 100:282, desktop 28:1596).
  Charcoal band, one product: image on a pale-green plate, stars, name,
  description, "in the box" chips, one green buy button.

  Paul's board comment #19: "Copy + price should be for GPOD X – $129.99",
  so the defaults point at GPOD X and the button price is read live from
  the product (never typed), so it cannot drift from the PDP.

  Chips come from the `gpod.box_contents` metafield (one item per line)
  unless chip blocks are added, which then win.

  Styles: assets/gpod-ts.css §2.
{%- endcomment -%}

{{ 'gpod-ts.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign p = section.settings.product
  assign title = section.settings.heading
  if title == blank and p != blank
    assign title = p.title
  endif

  assign cutout = ''
  if section.settings.image == blank and p != blank and section.settings.use_cutout
    capture cutout
      render 'gpod-cutout-url', handle: p.handle
    endcapture
    assign cutout = cutout | strip
  endif

  assign rating = 0
  assign rating_count = 0
  if p != blank
    assign rating = p.metafields.reviews.rating.value.rating | default: 0
    assign rating_count = p.metafields.reviews.rating_count.value | default: 0
  endif

  assign chip_blocks = section.blocks | where: 'type', 'chip'
  assign box_lines = ''
  if chip_blocks.size == 0 and p != blank and p.metafields.gpod.box_contents != blank
    assign box_lines = p.metafields.gpod.box_contents.value | newline_to_br | split: '<br />'
  endif

  assign price = ''
  if p != blank
    assign price = p.price | money
  endif
  assign cta = section.settings.cta_label | replace: '[price]', price
  if p != blank
    assign cta = cta | replace: '[title]', p.title
  endif
-%}

<section class="ts ts--dark ts-spot ts-section" data-section-id="{{ section.id }}" data-section-type="home-spotlight">
  <div class="ts-wrap">
    <article class="ts-spot__card">
      <div class="ts-spot__media{% if section.settings.image != blank and section.settings.image_cover %} ts-spot__media--photo{% endif %}">
        {%- if section.settings.badge != blank -%}<span class="ts-spot__badge">{{ section.settings.badge | escape }}</span>{%- endif -%}
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: title -}}
        {%- elsif cutout != blank -%}
          <img src="{{ cutout }}" alt="{{ title | escape }}" width="700" height="700" loading="lazy">
        {%- elsif p.featured_image != blank -%}
          {{- p.featured_image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'lazy', alt: title -}}
        {%- endif -%}
      </div>

      <div class="ts-spot__body">
        <div class="ts-spot__rating">
          <span class="ts-stars" role="img" aria-label="{% if rating > 0 %}{{ rating }} out of 5 stars{% else %}5 stars{% endif %}">
            {%- for i in (1..5) -%}{% render 'ts-icon', name: 'star-fill' %}{%- endfor -%}
          </span>
          {%- if section.settings.show_count and rating_count > 0 -%}
            <span>{{ rating }} · {{ rating_count }} reviews</span>
          {%- endif -%}
        </div>

        <h2 class="ts-h2 ts-spot__title">{{ title | escape }}</h2>

        <div class="ts-body ts-spot__desc">
          {%- if section.settings.text != blank -%}
            {{ section.settings.text }}
          {%- elsif p != blank -%}
            <p>{{ p.description | strip_html | truncatewords: 60 }}</p>
          {%- endif -%}
        </div>

        {%- if chip_blocks.size > 0 or box_lines != '' -%}
          <div class="ts-spot__box">
            {%- if section.settings.box_title != blank -%}<p class="ts-spot__box-title">{{ section.settings.box_title | escape }}</p>{%- endif -%}
            <ul class="ts-spot__chips" role="list">
              {%- if chip_blocks.size > 0 -%}
                {%- for block in chip_blocks -%}
                  <li class="ts-chip" {{ block.shopify_attributes }}>
                    <span class="ts-chip__icon">{% render 'ts-icon', name: 'check' %}</span>{{ block.settings.label | escape }}
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for line in box_lines -%}
                  {%- assign item = line | strip -%}
                  {%- if item != blank -%}
                    <li class="ts-chip"><span class="ts-chip__icon">{% render 'ts-icon', name: 'check' %}</span>{{ item | escape }}</li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if p != blank -%}
          <div class="ts-spot__cta">
            <a class="ts-btn" href="{{ p.url }}">{{ cta | escape }}</a>
            {%- if section.settings.secondary_label != blank -%}
              <div><a class="ts-link ts-spot__more" href="{{ section.settings.secondary_link | default: p.url }}">{{ section.settings.secondary_label | escape }}</a></div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Blank = product title", "default": "GPOD : GPOD X" },
    { "type": "richtext", "id": "text", "label": "Description", "info": "Blank = product description" },
    { "type": "image_picker", "id": "image", "label": "Image override" },
    { "type": "checkbox", "id": "image_cover", "label": "Image is a photo (fill the frame)", "info": "Leave off for a cut-out product render on the green plate", "default": false },
    { "type": "checkbox", "id": "use_cutout", "label": "Use the background-free cutout when there is one", "default": true },
    { "type": "text", "id": "badge", "label": "Badge" },
    { "type": "checkbox", "id": "show_count", "label": "Show rating + review count", "default": false },
    { "type": "text", "id": "box_title", "label": "Chips title" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy [title] for [price]", "info": "[title] and [price] are filled from the product" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "blocks": [
    { "type": "chip", "name": "Chip", "limit": 8, "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Adjustable Ball Head" } ] }
  ],
  "presets": [ { "name": "Product spotlight" } ]
}
{% endschema %}
