{% comment %}
  Spec comparison table. Columns are product blocks; rows are driven by the
  `gpod.*` product metafields (see docs/product-data.md) and hide automatically
  when no selected product has a value for them.
{% endcomment %}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}

{%- liquid
  assign spec_keys = 'best_for,extended_length,collapsed_length,weight,base_detail,phone_attachment,remote_included,bag_fit,materials' | split: ','
  assign spec_labels = 'Best for,Extended height,Collapsed length,Weight,Base,Phone attachment,Remote,Golf bag fit,Materials' | split: ','
-%}

<section class="gpod-section gpod-compare container-wrap section-padding{% if section.settings.center_heading %} gpod-section--center{% endif %}"
  id="compare-{{ section.id }}"
  data-section-type="compare-table"
  style="{{ style }}"
>
  <div class="container">
    {%- if section.settings.kicker != blank -%}
      <p class="gpod-kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="gpod-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="gpod-lede">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gpod-compare__scroller" tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Product comparison' | escape }}">
        <table>
          <caption class="visually-hidden">{{ section.settings.heading | default: 'Product comparison' | escape }}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Spec</span></th>
              {%- for block in section.blocks -%}
                {%- assign product = block.settings.product -%}
                <th scope="col" class="gpod-compare__product" {{ block.shopify_attributes }}>
                  {%- if product != blank -%}
                    {%- if block.settings.badge != blank -%}
                      <span class="gpod-compare__badge">{{ block.settings.badge | escape }}</span>
                    {%- endif -%}
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 220 }}"
                        srcset="{{ product.featured_image | image_url: width: 220 }} 1x, {{ product.featured_image | image_url: width: 440 }} 2x"
                        width="110" height="110" loading="lazy"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      >
                    {%- endif -%}
                    <a class="gpod-compare__title" href="{{ product.url }}">{{ product.title }}</a>
                    <span class="gpod-compare__price">
                      {{- product.price | money -}}
                      {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
                    </span>
                    <a class="gpod-compare__cta btn btn--primary btn--solid btn--small" href="{{ product.url }}">Shop</a>
                  {%- else -%}
                    <span class="gpod-compare__empty">Select a product</span>
                  {%- endif -%}
                </th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for key in spec_keys -%}
              {%- liquid
                assign row_has_value = false
                for block in section.blocks
                  assign product = block.settings.product
                  if product != blank and product.metafields.gpod[key].value != blank
                    assign row_has_value = true
                  endif
                endfor
              -%}
              {%- if row_has_value -%}
                <tr>
                  <th scope="row">{{ spec_labels[forloop.index0] }}</th>
                  {%- for block in section.blocks -%}
                    {%- assign product = block.settings.product -%}
                    <td>
                      {%- if product != blank and product.metafields.gpod[key].value != blank -%}
                        {{- product.metafields.gpod[key].value -}}
                      {%- else -%}
                        <span class="gpod-compare__empty" aria-label="Not applicable">—</span>
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <p class="gpod-compare__hint gpod-compare__hint--mobile">Swipe sideways to see all models →</p>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="gpod-compare__hint">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Compare table",
  "class": "shopify-section--compare-table",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Which GPOD is right for you?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare GPOD models"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Every GPOD holds your phone magnetically and films your swing. The difference is where you practice and how you carry it — compare the specs that matter.</p>"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Center heading",
      "default": false
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "default": "<p>Still unsure? <a href=\"/pages/product-finder-quiz\">Take the 30-second product finder</a> or <a href=\"/pages/contact-us\">ask us directly</a>.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product column",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (e.g. Most popular)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "category": "Product",
      "name": "Compare table",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
