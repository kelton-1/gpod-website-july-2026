{% comment %}
  Spec comparison table. Columns are product blocks; rows are driven by the
  `gpod.*` product metafields (see docs/product-data.md) and hide automatically
  when no selected product has a value for them.

  With "Interactive picker" enabled (the Compare page), every column gets a
  model dropdown fed by the candidate list below — Apple-compare style. The
  server-rendered table is the no-JS fallback; gpod.js re-renders columns on
  selection and honours ?models=handle1,handle2 deep links.
{% endcomment %}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}

{%- liquid
  assign page_product = product
  assign spec_keys = 'best_for,extended_length,collapsed_length,weight,base_detail,phone_attachment,remote_included,bag_fit,materials' | split: ','
  assign spec_labels = 'Best for,Extended height,Collapsed length,Weight,Base,Phone attachment,Remote,Golf bag fit,Materials' | split: ','

  # Optional short set. The full 9 specs across 3 models runs ~2,500px on a
  # phone once the table reflows to spec-major, which is far too long for a
  # homepage module — the compare PAGE is where the full set belongs.
  assign max_specs = section.settings.max_specs | default: 0
  if max_specs > 0 and max_specs < spec_keys.size
    assign spec_keys = spec_keys | slice: 0, max_specs
    assign spec_labels = spec_labels | slice: 0, max_specs
  endif
  assign picker = section.settings.enable_picker
  assign default_candidates = 'gpodmagsafe,gpodx,gpod-pauly-p2,gpod-travel-1,gpod-studio,indoor-base-for-gpod-gpod-mini,gpod-anywhere-tripod,gpod-mini,g-bundle-one-gpod-with-gpod-base,g-bundle-two-gpod-x-with-gpod-base,g-bundle-three-gpod-pauly-p-and-gpod-base,gpod-travel-sportsbox-3d-player-annual-swing-analysis'
  assign candidate_handles = section.settings.candidate_handles | default: default_candidates | split: ','

  assign applicable_collection = section.settings.applicable_collection
  assign product_collection_handles = page_product.collections | map: 'handle'
  assign is_applicable = true

  if page_product != blank and applicable_collection != blank
    unless product_collection_handles contains applicable_collection.handle
      assign is_applicable = false
    endunless
  endif
-%}

{%- if is_applicable -%}
<section class="gpod-section gpod-compare container-wrap section-padding{% if section.settings.center_heading %} gpod-section--center{% endif %}{% if section.settings.layout == 'cards' %} gpod-compare--cards{% endif %}"
  id="compare-{{ section.id }}"
  data-section-type="compare-table"
  {% if picker %}data-compare-picker{% endif %}
  style="{{ style }}"
>
  <div class="container">
    {%- if section.settings.kicker != blank -%}
      <p class="gpod-kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="gpod-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="gpod-lede">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        Revealed by gpod.js when ?models= narrows the table to a shopper's
        picks — from the collection compare tray, or any link.
      {%- endcomment -%}
      <div class="gpod-compare__focus" data-compare-focus hidden>
        <span data-compare-focus-text></span>
        <button type="button" class="gpod-compare__showall" data-compare-showall>
          {{ section.settings.showall_label | default: 'Show all models' | escape }}
        </button>
      </div>

      <div class="gpod-compare__scroller" tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Product comparison' | escape }}">
        <table data-compare-table>
          <caption class="visually-hidden">{{ section.settings.heading | default: 'Product comparison' | escape }}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Spec</span></th>
              {%- for block in section.blocks -%}
                {%- assign product = block.settings.product -%}
                <th scope="col" class="gpod-compare__product" data-compare-col="{{ forloop.index0 }}" {% if product != blank %}data-compare-initial="{{ product.handle }}"{% endif %} {{ block.shopify_attributes }}>
                  <span data-compare-card>
                    {%- if product != blank -%}
                      {%- if block.settings.badge != blank -%}
                        <span class="gpod-compare__badge">{{ block.settings.badge | escape }}</span>
                      {%- endif -%}
                      {%- comment -%}
                        Prefer the background-free cutout. The gallery images
                        carry the "THE GPOD" wordmark baked into the pixels and
                        the product itself occupies a sliver of the frame, so at
                        110px they rendered as a logo with a hairline beside it.
                      {%- endcomment -%}
                      {%- capture cutout -%}{%- render 'gpod-cutout-url', handle: product.handle -%}{%- endcapture -%}
                      {%- if cutout != blank -%}
                        <img
                          class="gpod-compare__thumb"
                          src="{{ cutout }}"
                          width="110" height="140" loading="lazy"
                          alt="{{ product.title | escape }}"
                        >
                      {%- elsif product.featured_image -%}
                        <img
                          class="gpod-compare__thumb"
                          src="{{ product.featured_image | image_url: width: 220 }}"
                          srcset="{{ product.featured_image | image_url: width: 220 }} 1x, {{ product.featured_image | image_url: width: 440 }} 2x"
                          width="110" height="140" loading="lazy"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        >
                      {%- endif -%}
                      <a class="gpod-compare__title" href="{{ product.url }}">{{ product.title }}</a>
                      <span class="gpod-compare__price">
                        {{- product.price | money -}}
                        {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
                      </span>
                      <a class="gpod-compare__cta btn btn--primary btn--solid btn--small" href="{{ product.url }}">Shop</a>
                    {%- else -%}
                      <span class="gpod-compare__empty">Select a product</span>
                    {%- endif -%}
                  </span>
                </th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for key in spec_keys -%}
              {%- liquid
                assign row_has_value = false
                for block in section.blocks
                  assign product = block.settings.product
                  if product != blank and product.metafields.gpod[key].value != blank
                    assign row_has_value = true
                  endif
                endfor
              -%}
              {%- if row_has_value or picker -%}
                <tr data-compare-row="{{ key }}"{% unless row_has_value %} hidden{% endunless %}>
                  <th scope="row">{{ spec_labels[forloop.index0] }}</th>
                  {%- for block in section.blocks -%}
                    {%- assign product = block.settings.product -%}
                    {%- comment -%}
                      data-compare-model carries the model name onto every
                      cell. On mobile the table reflows to a spec-major layout
                      where each value needs its own label, rendered from this
                      attribute with content: attr(). gpod.js keeps it in sync
                      when a shopper swaps a model.
                    {%- endcomment -%}
                    <td data-compare-col="{{ forloop.index0 }}" data-compare-model="{{ product.title | escape }}">
                      {%- if product != blank and product.metafields.gpod[key].value != blank -%}
                        {{- product.metafields.gpod[key].value -}}
                      {%- else -%}
                        <span class="gpod-compare__empty" aria-label="Not applicable">—</span>
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <p class="gpod-compare__hint gpod-compare__hint--mobile">Swipe sideways to see all models →</p>

      {%- if picker -%}
        <script type="application/json" data-compare-data>
          {
            "specKeys": {{ spec_keys | json }},
            "candidates": [
              {%- assign sep = '' -%}
              {%- for handle in candidate_handles -%}
                {%- assign c_handle = handle | strip -%}
                {%- assign p = all_products[c_handle] -%}
                {%- if p != blank -%}
                  {%- capture c_cutout -%}{%- render 'gpod-cutout-url', handle: p.handle -%}{%- endcapture -%}
                  {{ sep }}{
                    "handle": {{ p.handle | json }},
                    "title": {{ p.title | json }},
                    "url": {{ p.url | json }},
                    {%- comment -%}
                      Same preference as the server-rendered column above, so
                      swapping a model in the picker does not swap a cutout for
                      a branded gallery shot. A cutout is one fixed-size theme
                      asset, so image2x repeats it rather than being null —
                      gpod.js writes srcset unconditionally.
                    {%- endcomment -%}
                    {%- if c_cutout != blank -%}
                    "image": {{ c_cutout | json }},
                    "image2x": {{ c_cutout | json }},
                    {%- else -%}
                    "image": {% if p.featured_image %}{{ p.featured_image | image_url: width: 220 | json }}{% else %}null{% endif %},
                    "image2x": {% if p.featured_image %}{{ p.featured_image | image_url: width: 440 | json }}{% else %}null{% endif %},
                    {%- endif -%}
                    "price": {{ p.price | money | json }},
                    "compareAt": {% if p.compare_at_price > p.price %}{{ p.compare_at_price | money | json }}{% else %}null{% endif %},
                    "specs": {
                      {%- for key in spec_keys -%}
                        {{ key | json }}: {{ p.metafields.gpod[key].value | json }}{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    }
                  }
                  {%- assign sep = ',' -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          }
        </script>
        <script src="{{ 'gpod.js' | asset_url }}" defer></script>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="gpod-compare__hint">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Compare table",
  "class": "shopify-section--compare-table",
  "settings": [
    {
      "type": "collection",
      "id": "applicable_collection",
      "label": "Limit to collection on product pages",
      "info": "Optional. The section stays hidden on products outside this collection; non-product pages are unaffected."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Which GPOD is right for you?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare GPOD models"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Every GPOD holds your phone magnetically and films your swing. The difference is where you practice and how you carry it — compare the specs that matter.</p>"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Center heading",
      "default": false
    },
    {
      "type": "range",
      "id": "max_specs",
      "label": "Spec rows to show",
      "info": "0 shows all. Use a short set on the homepage and link to the full comparison.",
      "min": 0,
      "max": 9,
      "step": 1,
      "default": 0
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Cards suits a short 3-model picker (homepage). Table suits the full comparison (compare page).",
      "default": "table",
      "options": [
        { "label": "Table", "value": "table" },
        { "label": "Cards", "value": "cards" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_picker",
      "label": "Interactive model picker",
      "info": "Adds a dropdown to each column so shoppers can swap in any model. A ?models=handle,handle link — from the collection compare tray — narrows the table to just those models.",
      "default": false
    },
    {
      "type": "text",
      "id": "showall_label",
      "label": "\"Show all\" button label",
      "default": "Show all models"
    },
    {
      "type": "text",
      "id": "candidate_handles",
      "label": "Picker candidates (comma-separated handles)",
      "info": "Defaults to every compareable GPOD product."
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "default": "<p>Still unsure? <a href=\"/pages/product-finder-quiz\">Take the 30-second product finder</a> or <a href=\"/pages/contact-us\">ask us directly</a>.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product column",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (e.g. Most popular)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "category": "Product",
      "name": "Compare table",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
